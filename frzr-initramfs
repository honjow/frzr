#! /bin/bash

set -e

if [ $EUID -ne 0 ]; then
    echo "$(basename $0) must be run as root"
    exit 1
fi

log_info() {
    echo "$*" >&2
}

log_error() {
    echo "ERROR: $*" >&2
}

# Check if microcode hook is enabled in mkinitcpio.conf
detect_microcode_hook() {
    if grep -q "microcode" "/etc/mkinitcpio.conf" 2>/dev/null; then
        echo "# "
    else
        echo ""
    fi
}

# Parse deployment information from os-release
parse_deployment_info() {
    local os_release_file="$1"
    
    if [ ! -f "$os_release_file" ]; then
        log_error "os-release file not found: $os_release_file"
        return 1
    fi
    
    local id=$(grep '^ID=' "$os_release_file" | awk -F= '{print $2}' | sed 's/"//g')
    local version_id=$(grep '^VERSION_ID=' "$os_release_file" | awk -F= '{print $2}' | sed 's/"//g')
    local build_id=$(grep '^BUILD_ID=' "$os_release_file" | awk -F= '{print $2}' | sed 's/"//g')
    
    # 如果 BUILDID 包含_ 则只取最后一个_之后的部分
    if [[ $build_id == *"_"* ]]; then
        build_id=$(echo "$build_id" | awk -F_ '{print $NF}')
    fi
    
    local build_name="${id}-${version_id}_${build_id}"
    echo "$id $version_id $build_id $build_name"
}

mount_chroot_filesystems() {
    local subvol="$1"
    cd "$subvol"
    mount -t proc /proc proc/
    mount -t sysfs /sys sys/
    mount --rbind /dev dev/
    mount --rbind /etc/mkinitcpio.d etc/mkinitcpio.d/
}

unmount_chroot_filesystems() {
    local subvol="$1"
    umount -l "${subvol}/proc" 2>/dev/null || true
    umount -l "${subvol}/sys" 2>/dev/null || true
    mount --make-rslave "${subvol}/dev" 2>/dev/null || true
    umount -l "${subvol}/dev" 2>/dev/null || true
    umount -l "${subvol}/etc/mkinitcpio.d" 2>/dev/null || true
}

set_subvol_readonly() {
    local subvol="$1"
    local readonly="$2"
    btrfs property set -fts "$subvol" ro "$readonly"
}

get_subvol_readonly_state() {
    local subvol="$1"
    local state=$(btrfs property get -fts "$subvol" 2>/dev/null | grep "ro=" | cut -d'=' -f2)
    echo "$state"
}

build_initramfs_in_subvol() {
    local subvol="$1"
    local microcode_flag="$2"
    local build_name="$3"
    
    if [ -z "$subvol" ]; then
        log_error "No subvol specified"
        return 1
    fi
    
    if [ -z "$build_name" ]; then
        # Extract build name from subvol path if not provided
        build_name=$(basename "$subvol")
    fi

    mount_chroot_filesystems "$subvol"
    set_subvol_readonly "$subvol" false
    
    # Check UKI mode outside chroot
    local use_uki=false
    if should_use_uki; then
        use_uki=true
    fi
    
    chroot ${subvol} /bin/bash <<EOF
# Create distro mkinitcpio preset
if [ "$use_uki" = "true" ]; then
    # UKI mode preset
    echo '
ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/vmlinuz-linux"
${microcode_flag}ALL_microcode=(/boot/*-ucode.img)

PRESETS="default"

default_uki="/boot/EFI/Linux/${build_name%%-*}.efi"
default_options="--cmdline=/boot/uki-cmdline"
' > /etc/mkinitcpio.d/${build_name%%-*}.preset
else
    # Traditional mode preset
    echo '
ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/vmlinuz-linux"
${microcode_flag}ALL_microcode=(/boot/*-ucode.img)

PRESETS="default"

default_image="/boot/initramfs-linux.img"
' > /etc/mkinitcpio.d/${build_name%%-*}.preset
fi

# Rebuild initramfs with custom preset
mkinitcpio -p ${build_name%%-*}
EOF
    
    set_subvol_readonly "$subvol" true
    unmount_chroot_filesystems "$subvol"
    
    # UKI post-processing (outside chroot, using correct paths)
    if should_use_uki; then
        local uki_file="/boot/EFI/Linux/${build_name%%-*}.efi"
        if [ -f "$uki_file" ]; then
            log_info "UKI 构建成功：$uki_file"
            
            # Handle backup files
            if [ "$(get_uki_config "keep_backup" "true")" = "false" ]; then
                rm -rf "/boot/${build_name%%-*}"
                rm -f "/boot/loader/entries/frzr.conf"
                log_info "已删除传统文件以节省空间"
            fi
            
            # Set UKI as default boot entry
            echo "default ${build_name%%-*}.efi" > /boot/loader/loader.conf
            log_info "已设置 UKI 为默认启动项"
        else
            # UKI build failed, ensure traditional mode
            echo "default frzr.conf" > /boot/loader/loader.conf
            log_info "UKI 构建失败，使用传统启动模式"
        fi
    else
        # Traditional mode - set frzr.conf as default
        echo "default frzr.conf" > /boot/loader/loader.conf
        log_info "传统模式：已设置 frzr.conf 为默认启动项"
    fi
}

build_initramfs_for_deployment() {
    local boot_path="$1"
    local deployment_id="$2"
    local build_name="$3"
    local microcode_flag="$4"
    
    if [ -z "$deployment_id" ] || [ -z "$build_name" ] || [ -z "$boot_path" ]; then
        log_error "Missing required parameters for deployment build"
        return 1
    fi
    
    if should_use_uki; then
        # Generate uki-cmdline using same logic as __frzr-deploy
        local uki_cmdline_file="$boot_path/uki-cmdline"
        if [ ! -f "$uki_cmdline_file" ]; then
            log_info "uki-cmdline not found, generating using __frzr-deploy logic"
            # Source __frzr-deploy to get generate_kernel_cmdline function
            if [ -f "/usr/bin/__frzr-deploy" ]; then
                source /usr/bin/__frzr-deploy
            else
                source "$(dirname "$0")/__frzr-deploy"
            fi
            generate_kernel_cmdline "$build_name" "/frzr_root/deployments/$build_name" > "$uki_cmdline_file"
        fi
        
        # UKI mode preset
        cat > "/etc/mkinitcpio.d/${deployment_id}.preset" <<EOF
ALL_config="/etc/mkinitcpio.conf"
ALL_kver="$boot_path/$build_name/vmlinuz-linux"
${microcode_flag}ALL_microcode=($boot_path/$build_name/*-ucode.img)

PRESETS="default"

default_uki="$boot_path/EFI/Linux/$build_name.efi"
default_options="--cmdline=$boot_path/uki-cmdline"
EOF
    else
        # Traditional mode preset
        cat > "/etc/mkinitcpio.d/${deployment_id}.preset" <<EOF
ALL_config="/etc/mkinitcpio.conf"
ALL_kver="$boot_path/$build_name/vmlinuz-linux"
${microcode_flag}ALL_microcode=($boot_path/$build_name/*-ucode.img)

PRESETS="default"

default_image="$boot_path/initramfs-linux.img"
EOF
    fi
    
    mkinitcpio -p "$deployment_id"
    
    # UKI post-processing for deployment builds
    if should_use_uki; then
        if [ -f "$boot_path/EFI/Linux/$build_name.efi" ]; then
            log_info "UKI 构建成功：$boot_path/EFI/Linux/$build_name.efi"
            
            # Handle backup files
            if [ "$(get_uki_config "keep_backup" "true")" = "false" ]; then
                rm -rf "$boot_path/$build_name"
                rm -f "/boot/loader/entries/frzr.conf"
                log_info "已删除传统文件以节省空间"
            fi
            
            # Set UKI as default boot entry
            echo "default $build_name.efi" > /boot/loader/loader.conf
            log_info "已设置 UKI 为默认启动项"
        else
            # UKI build failed, ensure traditional mode
            echo "default frzr.conf" > /boot/loader/loader.conf
            log_info "UKI 构建失败，使用传统启动模式"
        fi
    else
        # Traditional mode - set frzr.conf as default
        echo "default frzr.conf" > /boot/loader/loader.conf
        log_info "传统模式：已设置 frzr.conf 为默认启动项"
    fi
}

copy_boot_files_if_unlocked() {
    local BUILD="$1"
    
    if [[ -d "/boot/$BUILD" ]]; then
        cp "/boot/$BUILD"/* /boot/ 2>/dev/null || true
    fi

    if [[ -d "/efi/$BUILD" ]]; then
        cp "/efi/$BUILD"/* /efi/ 2>/dev/null || true
        cp "/efi/$BUILD"/* /boot/ 2>/dev/null || true
    fi

    if [[ -d "/frzr_root/boot/$BUILD" ]]; then
        cp "/frzr_root/boot/$BUILD"/* "/frzr_root/boot/" 2>/dev/null || true
        cp "/frzr_root/boot/$BUILD"/* /boot/ 2>/dev/null || true
    fi
}

process_install_media() {
    if [ -d "$SUBVOL" ]; then
        local microcode_flag=$(detect_microcode_hook)
        local build_name=$(basename "$SUBVOL")
        build_initramfs_in_subvol "$SUBVOL" "$microcode_flag" "$build_name"
    else
        log_error "No deployment directory found"
        return 1
    fi
}

process_deployed_system() {
    local os_release_file
    
    if [ -n "$SUBVOL" ]; then
        os_release_file="$SUBVOL/etc/os-release"
    else
        os_release_file="/etc/os-release"
    fi
    
    local deployment_info=$(parse_deployment_info "$os_release_file")
    if [ -z "$deployment_info" ]; then
        log_error "Failed to parse deployment information"
        return 1
    fi
    
    read -r ID VERSIONID BUILDID BUILD <<< "$deployment_info"
    DEPLOYMENT_PATH="/frzr_root/deployments/$BUILD"
    
    if [[ ! -d $DEPLOYMENT_PATH ]]; then
        log_error "No deployment found for $BUILD"
        return 1
    fi

    echo "Generating configuration for $BUILD"
    
    # Get locked state
    RELOCK=0
    LOCK_STATE=$(btrfs property get -fts "$DEPLOYMENT_PATH")
    if [[ $LOCK_STATE == *"ro=true"* ]]; then
        btrfs property set -fts ${DEPLOYMENT_PATH} ro false
        RELOCK=1
    else
        echo "Filesystem appears to be unlocked"
    fi
    
    local microcode_flag=$(detect_microcode_hook)
    
    if [ -n "$SUBVOL" ]; then
        build_initramfs_in_subvol "$SUBVOL" "$microcode_flag" "$BUILD"
    elif [[ -d "/efi/$BUILD" ]] && grep -q "HOOKS=.*systemd" "/etc/mkinitcpio.conf"; then
        build_initramfs_for_deployment "/efi" "$ID" "$BUILD" "$microcode_flag"
    else
        build_initramfs_for_deployment "/frzr_root/boot" "$ID" "$BUILD" "$microcode_flag"
    fi
    
    if [[ $RELOCK == 1 ]]; then
        btrfs property set -fts ${DEPLOYMENT_PATH} ro true
    else
        # Move rebuilt images to the unlocked location if system was unlocked prior
        copy_boot_files_if_unlocked "$BUILD"
    fi
}

# Check if script is being run from the install media
if [ -d /tmp/frzr_root ]; then
    process_install_media
else
    echo "We don't appear to be running from an arch install media"
fi

# UKI support functions
detect_uki_support() {
    command -v ukify >/dev/null 2>&1 && [ -d "/boot/loader" ]
}

get_uki_config() {
    local config_file="/etc/frzr-sk.conf"
    local key="$1"
    local default="$2"
    
    if [ -f "$config_file" ]; then
        grep "^${key}" "$config_file" | cut -d'=' -f2 | tr -d ' ' || echo "$default"
    else
        echo "$default"
    fi
}

should_use_uki() {
    local enable=$(get_uki_config "enable" "auto")
    
    case "$enable" in
        "true")
            if detect_uki_support; then
                return 0
            else
                log_error "UKI 被强制启用但系统不支持"
                return 1
            fi
            ;;
        "false")
            return 1
            ;;
        "auto"|*)
            detect_uki_support
            ;;
    esac
}

if [ -d /frzr_root ]; then
    process_deployed_system
fi
