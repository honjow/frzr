#! /bin/bash
# shellcheck disable=SC2155,SC2001

set -xe

# 初始化文件描述符3为stdout，供whiptail重定向使用
exec 3>&1

# 脚本用法:
# ./frzr-bootstrap [USERNAME] [DISK] [INSTALL_TYPE]
#
# 参数说明:
# USERNAME: 用户名 (默认: gamer)
# DISK: 目标磁盘 (如不指定则显示选择菜单)
# INSTALL_TYPE: 安装类型
#   - fresh: 全新安装 (格式化整个磁盘)
#   - dual: 双系统安装 (保留现有系统)
#   - 如不指定则显示选择菜单

if [ $EUID -ne 0 ]; then
	echo "$(basename "$0") must be run as root"
	exit 1
fi

# 全局变量
MOUNT_PATH=/tmp/frzr_root
umount ${MOUNT_PATH}/boot/ || true
umount ${MOUNT_PATH}/ || true

# 全局变量，用于记录释放空间位置
FREE_SPACE_START_GIB=""
FREE_SPACE_SIZE_GIB=""

# 全局变量记录选择的空闲空间
SELECTED_FREE_SPACE_START=""
SELECTED_FREE_SPACE_END=""

########## 磁盘选择相关函数

function select_disk() {
	if [ -n "$1" ]; then
		DISK=$1
		echo "使用指定磁盘: $DISK"
	else
		device_list=()
		device_output=$(lsblk --list -n -o name,model,size,type | grep disk | grep -v zram | tr -s ' ' '\t')

		while read -r line; do
			name=/dev/$(echo "$line" | cut -f 1)
			model=$(echo "$line" | cut -f 2)
			size=$(echo "$line" | cut -f 3)
			device_list+=("$name")
			device_list+=("$model ($size)")
		done <<<"$device_output"

		DISK=$(whiptail --menu "选择要安装到的磁盘:" 20 50 5 "${device_list[@]}" 3>&1 1>&2 2>&3)
		echo "用户选择磁盘: $DISK"
	fi
}

function check_existing_installation() {
	if (lsblk -o label "${DISK}" | grep -q frzr_efi); then
		echo "检测到现有frzr安装"
		return 0
	else
		echo "未检测到现有frzr安装"
		return 1
	fi
}

function choose_repair_or_reinstall() {
	local choice=$(whiptail --menu "检测到现有的frzr安装，请选择操作:" 15 70 3 \
		"repair" "修复安装 - 保留用户数据，修复引导和系统文件" \
		"reinstall" "重新安装 - 进入安装选项，可选择全新安装或双系统安装" \
		3>&1 1>&2 2>&3)

	case "$choice" in
	"repair")
		echo "repair"
		;;
	"reinstall")
		echo "reinstall"
		;;
	"*")
		echo "cancel"
		;;
	esac
}

function choose_install_type() {
	if [ -n "$1" ]; then
		echo "$1"
	else
		# 检测现有系统
		detect_existing_systems
		show_system_info

		# 显示安装类型选择
		local install_type=$(whiptail --menu "选择安装类型:" 15 60 2 \
			"fresh" "全新安装 (格式化整个磁盘)" \
			"dual" "双系统安装 (保留现有系统)" \
			3>&1 1>&2 2>&3)

		if [ $? -ne 0 ]; then
			echo "安装已取消"
			exit 1
		fi

		echo "$install_type"
	fi
}

########## 原有功能函数封装

function repair_install() {
	echo "=== 修复安装模式 ==="

	mkdir -p "${MOUNT_PATH}"
	INSTALL_MOUNT=$(lsblk -rno "path,label" "${DISK}" | grep "frzr_root" | awk '{print $1}')
	BOOT_EFI=$(lsblk -rno "path,label" "${DISK}" | grep "frzr_efi" | awk '{print $1}')
	mount "${INSTALL_MOUNT}" "${MOUNT_PATH}"
	mount -t vfat "${BOOT_EFI}" "${MOUNT_PATH}/boot/"
	rm -rf "${MOUNT_PATH:?}/boot/"*
	bootctl --esp-path="${MOUNT_PATH}/boot/" install

	echo "deleting subvolume..."
	btrfs subvolume delete "${MOUNT_PATH}/deployments/"* || true

	rm -rf "${MOUNT_PATH:?}/etc/"*

	echo "修复安装完成"
}

function fresh_install() {
	local username="$1"

	echo "=== 全新安装模式 ==="

	if ! (whiptail --yesno "警告: $DISK 将被格式化。磁盘上的所有数据将丢失。您是否要继续?" 10 50 3>&1 1>&2 2>&3); then
		whiptail --msgbox "安装已取消" 10 50 3>&1 1>&2 2>&3
		echo "installation aborted"
		exit 1
	fi

	USERNAME=${username:-gamer}

	mkdir -p ${MOUNT_PATH}

	# create partition table and create and mount the btrfs filesystem
	parted --script "${DISK}" \
		mklabel gpt \
		mkpart primary fat32 1MiB 1024MiB \
		set 1 esp on \
		mkpart primary 1024MiB 100%

	PART1=$(fdisk -o Device --list "${DISK}" | grep "^${DISK}.*1$")
	PART2=$(fdisk -o Device --list "${DISK}" | grep "^${DISK}.*2$")

	mkfs.btrfs -L frzr_root -f "${PART2}"
	mount -t btrfs -o nodatacow "${PART2}" "${MOUNT_PATH}"

	btrfs subvolume create "${MOUNT_PATH}/var"
	btrfs subvolume create "${MOUNT_PATH}/home"

	mkdir -p "${MOUNT_PATH}/home/${USERNAME}"
	chown 1000:1000 "${MOUNT_PATH}/home/${USERNAME}"

	mkdir "${MOUNT_PATH}/boot"
	mkdir -p "${MOUNT_PATH}/etc"
	mkdir -p "${MOUNT_PATH}/.etc"

	# setup boot partition & install bootloader
	mkfs.vfat "${PART1}"
	dosfslabel "${PART1}" frzr_efi
	mount -t vfat "${PART1}" "${MOUNT_PATH}/boot/"
	bootctl --esp-path="${MOUNT_PATH}/boot/" install
	parted "${DISK}" set 1 boot on

	echo "全新安装完成"
}

########## 双系统检测函数

function detect_existing_systems() {
	EXISTING_SYSTEMS=()

	# 检测Windows
	if lsblk -f | grep -q "ntfs"; then
		EXISTING_SYSTEMS+=("Windows")
	fi

	# 检测Linux
	if lsblk -f | grep -qE "(ext4|btrfs|xfs)" &&
		lsblk -o label | grep -vq "frzr_"; then
		EXISTING_SYSTEMS+=("Linux")
	fi

	# 检测macOS
	if lsblk -f | grep -q "apfs"; then
		EXISTING_SYSTEMS+=("macOS")
	fi
}

function show_system_info() {
	if [ ${#EXISTING_SYSTEMS[@]} -gt 0 ]; then
		echo "检测到现有系统: ${EXISTING_SYSTEMS[*]}" >&2
		echo "frzr 将安装到独立分区，不会影响现有系统" >&2
		echo "" >&2
	fi
}

function get_all_free_spaces2() {
	# 获取所有空闲空间，返回格式：start_mib end_mib size_mib
	parted "${DISK}" unit MiB print free 2>/dev/null |
		grep "Free Space" |
		awk '{
            gsub(/MiB/, "", $1);
            gsub(/MiB/, "", $2);
            start = $1;
            end = $2;
            size = int(end - start);
            print start, end, size;
        }'
}

function get_all_free_spaces() {
	parted "${DISK}" unit B print free 2>/dev/null |
		grep "Free Space" |
		while read -r line; do
			local start_bytes=$(echo "$line" | awk '{print $1}' | sed 's/B//')
			local end_bytes=$(echo "$line" | awk '{print $2}' | sed 's/B//')
			# 转换回MiB进行计算
			local start_mib=$((start_bytes / 1024 / 1024))
			local end_mib=$((end_bytes / 1024 / 1024))
			local size_mib=$((end_mib - start_mib))
			echo "$start_mib $end_mib $size_mib"
		done
}

function filter_usable_free_spaces() {
	local min_size_mib=$((55 * 1024)) # 55GiB = 55 * 1024 MiB

	get_all_free_spaces | while read -r start end size; do
		if [ "$size" -ge "$min_size_mib" ]; then
			local size_gib=$((size / 1024))
			echo "$start $end $size $size_gib"
		fi
	done
}

function select_free_space() {
	local usable_spaces=()

	# 读取所有可用的空闲空间
	while read -r start end size size_gib; do
		usable_spaces+=("${start}-${end}")
		usable_spaces+=("${size_gib}GiB 空闲空间")
	done < <(filter_usable_free_spaces)

	if [ ${#usable_spaces[@]} -eq 0 ]; then
		echo "未找到足够的空闲空间（需要≥55GiB）" >&2
		return 1
	elif [ ${#usable_spaces[@]} -eq 2 ]; then
		echo "只有一个选择，直接使用" >&2
		# 只有一个选择，直接使用
		local selected="${usable_spaces[0]}"
		SELECTED_FREE_SPACE_START=$(echo "$selected" | cut -d'-' -f1)
		SELECTED_FREE_SPACE_END=$(echo "$selected" | cut -d'-' -f2)
		return 0
	else
		# 多个选择，显示菜单
		local selected=$(whiptail --menu "选择要使用的空闲空间:" 15 60 5 \
			"${usable_spaces[@]}" 3>&1 1>&2 2>&3)

		if [ $? -eq 0 ]; then
			SELECTED_FREE_SPACE_START=$(echo "$selected" | cut -d'-' -f1)
			SELECTED_FREE_SPACE_END=$(echo "$selected" | cut -d'-' -f2)
			return 0
		else
			return 1
		fi
	fi
}

function get_free_space_boundaries() {
	if [ -n "$SELECTED_FREE_SPACE_START" ] && [ -n "$SELECTED_FREE_SPACE_END" ]; then
		echo "$SELECTED_FREE_SPACE_START $SELECTED_FREE_SPACE_END"
	else
		# fallback 到原有逻辑 - 选择最大的空闲空间而不是最后一个
		local free_info=$(parted "$DISK" unit MiB print free | awk '/Free Space/ {gsub(/MiB/, "", $3); size = $3 + 0; if (size > max_size) {max_size = size; max_line = $0}} END {print max_line}')
		local free_start=$(echo "$free_info" | awk '{print $1}' | sed 's/MiB//')
		local free_end=$(echo "$free_info" | awk '{print $2}' | sed 's/MiB//')
		echo "$free_start $free_end"
	fi
}

function check_unallocated_space() {
	if select_free_space; then
		local size_gib=$(((SELECTED_FREE_SPACE_END - SELECTED_FREE_SPACE_START) / 1024))
		echo "选择了 ${size_gib}GiB 空闲空间 (${SELECTED_FREE_SPACE_START}MiB - ${SELECTED_FREE_SPACE_END}MiB)"
		return 0
	else
		echo "未找到足够的空闲空间（需要≥55GiB）"
		return 1
	fi
}

########## 分区操作函数

function cleanup_temp_mount() {
	local temp_mount="$1"
	umount "$temp_mount" 2>/dev/null || true
	rmdir "$temp_mount" 2>/dev/null || true
}

function detect_system_partition() {
	local partition="$1"
	local fstype="$2"
	local temp_mount="/tmp/check_partition_$$"

	# 创建临时挂载点
	mkdir -p "$temp_mount"

	# 尝试挂载分区进行检查
	local mount_success=false
	case "$fstype" in
	"ntfs")
		if mount -t ntfs -o ro,noatime "$partition" "$temp_mount" 2>/dev/null; then
			mount_success=true
		fi
		;;
	"ext4")
		if mount -t ext4 -o ro,noatime "$partition" "$temp_mount" 2>/dev/null; then
			mount_success=true
		fi
		;;
	"btrfs")
		if mount -t btrfs -o ro,noatime "$partition" "$temp_mount" 2>/dev/null; then
			mount_success=true
		fi
		;;
	esac

	local warning=""
	if [ "$mount_success" = true ]; then
		# 检查Windows系统分区
		if [ "$fstype" = "ntfs" ]; then
			if [ -d "$temp_mount/Windows" ] && [ -d "$temp_mount/Program Files" ]; then
				warning=" *** Windows系统分区 ***"
			elif [ -d "$temp_mount/Windows" ]; then
				warning=" *** 疑似Windows分区 ***"
			fi
		fi

		# 检查Linux系统分区
		if [ "$fstype" = "ext4" ] || [ "$fstype" = "btrfs" ]; then
			if [ -d "$temp_mount/etc" ] && [ -d "$temp_mount/usr" ] && [ -d "$temp_mount/var" ]; then
				warning=" *** Linux系统分区 ***"
			elif [ -d "$temp_mount/etc" ]; then
				warning=" *** 疑似Linux分区 ***"
			fi
		fi
	fi

	# 清理临时挂载点
	cleanup_temp_mount "$temp_mount"

	echo "$warning"
}

function list_shrinkable_partitions() {
	SHRINKABLE_PARTITIONS=()

	# 获取所有分区信息
	while read -r line; do
		device_name=$(echo "$line" | awk '{print $1}')
		fstype=$(echo "$line" | awk '{print $2}')
		size_bytes=$(echo "$line" | awk '{print $3}')

		size=$((size_bytes / 1024 / 1024 / 1024))

		# 构造完整的设备路径
		device="/dev/$device_name"
		# 只要分区≥55GiB就可以选择
		if [[ -z "$size" ]] || [[ "$size" -lt 55 ]]; then
			continue
		fi

		# 检查是否支持操作
		case "$fstype" in
		"ntfs" | "ext4" | "btrfs")
			# 检测是否为系统分区
			local system_warning=$(detect_system_partition "$device" "$fstype")

			SHRINKABLE_PARTITIONS+=("$device")
			SHRINKABLE_PARTITIONS+=("$fstype (${size}GB)$system_warning")
			;;
		esac
	done < <(lsblk -rno NAME,FSTYPE,SIZE "${DISK}" --bytes | grep -v "^${DISK##*/}$")
}

function select_partition_to_shrink() {
	list_shrinkable_partitions

	if [ ${#SHRINKABLE_PARTITIONS[@]} -eq 0 ]; then
		whiptail --msgbox "没有找到可以操作的分区 (需要≥55GiB的ntfs/ext4/btrfs分区)" 10 60 3>&1 1>&2 2>&3
		return 1
	fi

	# 显示分区选择菜单
	SELECTED_PARTITION=$(whiptail --menu "选择要操作的分区:" 15 70 5 \
		"${SHRINKABLE_PARTITIONS[@]}" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ]; then
		echo "用户取消选择"
		return 1
	fi

	echo "用户选择分区: $SELECTED_PARTITION"
}

function select_shrink_size() {
	# 获取选定分区的详细信息
	local partition_info=$(lsblk -o NAME,SIZE,FSTYPE "$SELECTED_PARTITION" | tail -1)
	local partition_size=$(echo "$partition_info" | awk '{print $2}')
	local partition_fstype=$(echo "$partition_info" | awk '{print $3}')

	# 检查是否为系统分区
	local system_warning=$(detect_system_partition "$SELECTED_PARTITION" "$partition_fstype")

	SIZE_OPTIONS=(
		"60" "60GiB (最小安装，不推荐)"
		"100" "100GiB (常规安装)"
		"200" "200GiB (推荐)"
		"all" "*** 删除整个分区 (该分区将完全消失) ***"
	)

	# 如果是系统分区，在菜单标题中显示警告
	local menu_title="选择操作 - 分区: $SELECTED_PARTITION ($partition_size)$system_warning"

	SHRINK_SIZE=$(whiptail --menu "$menu_title" 16 70 4 \
		"${SIZE_OPTIONS[@]}" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ]; then
		echo "用户取消选择"
		return 1
	fi

	case "$SHRINK_SIZE" in
	"60") SHRINK_SIZE_GB=60 ;;
	"100") SHRINK_SIZE_GB=100 ;;
	"200") SHRINK_SIZE_GB=200 ;;
	"all")
		# 显示分区详细信息并警告
		local warning_text="*** 极度危险警告 ***\n\n您选择了'删除整个分区':\n\n"
		warning_text+="分区: $SELECTED_PARTITION\n"
		warning_text+="大小: $partition_size\n"
		warning_text+="文件系统: $partition_fstype\n"

		if [ -n "$system_warning" ]; then
			warning_text+="\n*** 警告: 这是一个系统分区! ***\n"
			warning_text+="删除此分区将导致系统无法启动!\n"
		fi

		warning_text+="\n此操作将:\n"
		warning_text+="• 完全删除上述分区\n"
		warning_text+="• 该分区上的所有数据将永久丢失\n"
		warning_text+="• 此操作完全不可逆\n\n"
		warning_text+="您确定要继续吗？"

		if ! whiptail --yesno "$warning_text" 18 60 3>&1 1>&2 2>&3; then
			echo "用户取消危险操作"
			return 1
		fi

		# 系统分区需要额外确认
		if [ -n "$system_warning" ]; then
			if ! whiptail --yesno \
				"最后警告\n\n您即将删除系统分区，这将导致:\n• 计算机无法启动\n• 系统完全不可用\n• 所有程序和数据丢失\n\n您真的要继续吗？" \
				12 60 3>&1 1>&2 2>&3; then
				echo "用户取消危险操作"
				return 1
			fi
		fi

		SHRINK_SIZE_GB="delete_entire_partition"
		;;
	esac

	echo "用户选择: ${SHRINK_SIZE_GB}"
}

function shrink_selected_partition() {
	local partition="$SELECTED_PARTITION"
	local fstype=$(lsblk -no fstype "$partition")
	local size=$(lsblk -no size "$partition")

	# 检查分区是否存在
	if ! lsblk "$partition" >/dev/null 2>&1; then
		echo "错误：分区 $partition 不存在"
		return 1
	fi

	if [ "$SHRINK_SIZE_GB" = "delete_entire_partition" ]; then
		# 最终确认
		if ! whiptail --yesno \
			"*** 最终确认 - 不可逆操作 ***\n\n分区: $partition ($size, $fstype)\n\n操作: 完全删除该分区\n\n该分区上的所有数据将永久丢失！\n\n您确定要执行吗？" \
			15 60 3>&1 1>&2 2>&3; then
			echo "用户取消危险操作"
			return 1
		fi

		echo "删除整个分区: $partition ($size, $fstype)"

		# 获取分区号
		local part_num=$(echo "$partition" | sed 's/.*[^0-9]\([0-9]\+\)$/\1/')

		# 卸载分区（如果已挂载）
		umount "$partition" 2>/dev/null || true

		# 删除分区
		if ! parted "$DISK" rm "$part_num"; then
			echo "删除分区失败"
			return 1
		fi

		echo "分区已完全删除"
		
		# 刷新分区表并等待更新
		partprobe "$DISK"
		sleep 2
		
		# 清空全局变量，强制重新检测空闲空间
		SELECTED_FREE_SPACE_START=""
		SELECTED_FREE_SPACE_END=""

	else
		# 缩小分区逻辑
		local display_size="${SHRINK_SIZE_GB}GiB"

		if ! whiptail --yesno \
			"确认缩小分区?\n\n分区: $partition ($size, $fstype)\n释放空间: $display_size\n\n警告: 此操作有风险，请确保已备份重要数据!" \
			12 60 3>&1 1>&2 2>&3; then
			echo "用户取消缩小操作"
			return 1
		fi

		# 获取当前分区大小
		local current_size_gb=$(echo "$size" | sed 's/G//' | cut -d. -f1)
		local target_size_gb=$((current_size_gb - SHRINK_SIZE_GB))
		local target_size_bytes=$((target_size_gb * 1024 * 1024 * 1024))

		if [ "$target_size_gb" -le 10 ]; then
			echo "错误：缩小后的分区太小（<10GiB），操作取消"
			return 1
		fi

		# 执行缩小
		case "$fstype" in
		"ntfs")
			echo "缩小NTFS分区到 ${target_size_gb}GiB..."
			if ! ntfsresize --check "$partition"; then
				echo "NTFS文件系统检查失败"
				return 1
			fi
			if ! ntfsresize -f --size "${target_size_bytes}" "$partition"; then
				echo "NTFS分区缩小失败"
				return 1
			fi
			;;
		"ext4")
			echo "缩小ext4分区到 ${target_size_gb}GiB..."
			if ! e2fsck -f "$partition"; then
				echo "ext4文件系统检查失败"
				return 1
			fi
			if ! resize2fs -f "$partition" "${target_size_bytes}"; then
				echo "ext4分区缩小失败"
				return 1
			fi
			;;
		"btrfs")
			echo "缩小BTRFS分区到 ${target_size_gb}GiB..."
			local mountpoint=$(findmnt -n -o TARGET "$partition" 2>/dev/null)
			if [ -z "$mountpoint" ]; then
				# 如果未挂载，临时挂载
				local temp_mount="/tmp/btrfs_resize_$$"
				mkdir -p "$temp_mount"
				if mount -t btrfs "$partition" "$temp_mount"; then
					if ! btrfs filesystem resize "${target_size_bytes}" "$temp_mount"; then
						echo "BTRFS分区缩小失败"
						umount "$temp_mount"
						rmdir "$temp_mount"
						return 1
					fi
					umount "$temp_mount"
					rmdir "$temp_mount"
				else
					echo "无法挂载BTRFS分区"
					rmdir "$temp_mount"
					return 1
				fi
			else
				if ! btrfs filesystem resize "${target_size_bytes}" "$mountpoint"; then
					echo "BTRFS分区缩小失败"
					return 1
				fi
			fi
			;;
		esac

		# 更新分区表
		update_partition_table "$partition" "$SHRINK_SIZE_GB"

		# 记录释放空间位置和大小
		local part_num=$(echo "$partition" | sed 's/.*[^0-9]\([0-9]\+\)$/\1/')
		FREE_SPACE_START_GIB=$(parted "$DISK" unit GiB print | grep "^ *$part_num " | awk '{print $3}' | sed 's/GiB//')
		FREE_SPACE_SIZE_GIB=$SHRINK_SIZE_GB

		echo "释放空间: ${FREE_SPACE_START_GIB}GiB 起始，大小 ${FREE_SPACE_SIZE_GIB}GiB"
	fi
}

function update_partition_table() {
	local partition="$1"
	local shrink_size="$2"

	# 获取分区号
	local part_num=$(echo "$partition" | sed 's/.*[^0-9]\([0-9]\+\)$/\1/')

	# 获取当前分区信息
	local current_end=$(parted "$DISK" unit s print | grep "^ *$part_num " | awk '{print $3}')
	local shrink_sectors=$((shrink_size * 1024 * 1024 * 1024 / 512))
	local new_end=$(echo "$current_end" | sed 's/s//')
	new_end=$((new_end - shrink_sectors))

	# 检查计算结果是否合理
	if [ "$new_end" -le 0 ]; then
		echo "错误: 分区太小，无法缩小 ${shrink_size}GiB"
		return 1
	fi

	# 调整分区表 - 三层回退策略
	local success=false

	# 方法1: 使用 expect + parted
	if [ "$success" = false ] && command -v expect >/dev/null 2>&1; then
		echo "尝试使用 expect + parted 调整分区表..."
		if expect -c "
		spawn parted $DISK resizepart $part_num ${new_end}s
		expect {
			\"确定要继续吗*\" { send \"yes\r\" }
			\"Are you sure you want to continue*\" { send \"yes\r\" }
			\"continue?*\" { send \"yes\r\" }
		}
		expect eof
		" 2>/dev/null; then
			echo "expect + parted 方法成功"
			success=true
		else
			echo "expect + parted 方法失败，尝试下一种方法"
		fi
	fi

	# 方法2: 使用 sfdisk
	if command -v sfdisk >/dev/null 2>&1; then
		echo "尝试使用 sfdisk 调整分区表..."
		# 获取当前分区信息
		local current_info=$(sfdisk --list "$DISK" 2>/dev/null | grep "^${partition}[[:space:]]" | head -1)
		if [ -n "$current_info" ]; then
			local current_start=$(echo "$current_info" | awk '{print $2}')
			local current_sectors=$(echo "$current_info" | awk '{print $4}')
			local new_sectors=$((current_sectors - shrink_sectors))
			
			# 检查新大小是否合理
			if [ "$new_sectors" -le 0 ]; then
				echo "错误: 分区太小，无法缩小 ${shrink_size}GiB，sfdisk 方法跳过"
			elif echo "$part_num : start=$current_start, size=$new_sectors" | sfdisk --force "$DISK" 2>/dev/null; then
				echo "sfdisk 方法成功"
				success=true
			else
				echo "sfdisk 方法失败，尝试下一种方法"
			fi
		else
			echo "无法获取分区信息，sfdisk 方法跳过"
		fi
	fi

	# 方法3: 使用 parted -s -f (保底方案 可能会失败)
	if [ "$success" = false ]; then
		echo "尝试使用 parted --script --fix 调整分区表..."
		if parted --script --fix "$DISK" resizepart "$part_num" "${new_end}s" 2>/dev/null; then
			echo "parted script 方法成功"
			success=true
		else
			echo "所有自动化方法都失败，分区表更新失败"
			return 1
		fi
	fi

	# 重新读取分区表
	partprobe "$DISK"

	# 等待分区表更新
	sleep 1

	echo "分区表已更新"
}

########## 双系统安装函数

function create_dual_boot_partitions() {
	local ACTUAL_START_MIB
	local ACTUAL_END_MIB
	read -r ACTUAL_START_MIB ACTUAL_END_MIB <<<"$(get_free_space_boundaries)"
	echo >&2 "ACTUAL_START_MIB: $ACTUAL_START_MIB, ACTUAL_END_MIB: $ACTUAL_END_MIB"
	if [ -n "$ACTUAL_START_MIB" ]; then
		# 预留1MiB缓冲空间以处理对齐问题
		local buffer_start_mib=$((ACTUAL_START_MIB + 1))
		local efi_end_mib=$((buffer_start_mib + 1024))

		echo >&2 "在释放空间中创建分区: ${buffer_start_mib}MiB - ${ACTUAL_END_MIB}MiB (预留1MiB缓冲，原始: ${ACTUAL_START_MIB}MiB)"

		# 创建EFI分区
		if ! parted --script --fix "$DISK" mkpart primary fat32 "${buffer_start_mib}MiB" "${efi_end_mib}MiB"; then
			echo "创建EFI分区失败"
			return 1
		fi

		# 创建根分区
		if ! parted --script "$DISK" mkpart primary "${efi_end_mib}MiB" "${ACTUAL_END_MIB}MiB"; then
			echo "创建根分区失败"
			return 1
		fi

		# 重新读取分区表
		partprobe "$DISK"
		sleep 1

		# 通过起始位置找到EFI分区编号
		local efi_part_num=$(parted "$DISK" unit MiB print | awk -v start="$buffer_start_mib" '$2 ~ start {print $1}')
		if ! parted "$DISK" set "$efi_part_num" esp on; then
			echo "设置EFI分区标志失败"
			return 1
		fi

	else
		echo "未找到未分配空间" >&2
		return 1
	fi

	# 获取新创建的分区路径
	if [ -n "$ACTUAL_START_MIB" ]; then
		# 释放空间情况：通过起始位置找分区
		local efi_start_mib=$buffer_start_mib
		local root_start_mib=$efi_end_mib

		# 通过parted找到分区编号，然后构造路径
		local efi_part_num=$(parted "$DISK" unit MiB print | awk -v start="$efi_start_mib" '$2 ~ start {print $1}')
		local root_part_num=$(parted "$DISK" unit MiB print | awk -v start="$root_start_mib" '$2 ~ start {print $1}')

		# 构造分区路径
		if [[ "$DISK" == *"nvme"* ]]; then
			FRZR_EFI_PART="${DISK}p${efi_part_num}"
			FRZR_ROOT_PART="${DISK}p${root_part_num}"
		else
			FRZR_EFI_PART="${DISK}${efi_part_num}"
			FRZR_ROOT_PART="${DISK}${root_part_num}"
		fi
	else
		# 未分配空间情况：确实是最后两个分区
		local all_partitions=$(lsblk -rno "path" "${DISK}" | grep -E "p?[0-9]+$" | sort)
		FRZR_EFI_PART=$(echo "$all_partitions" | tail -2 | head -1)
		FRZR_ROOT_PART=$(echo "$all_partitions" | tail -1)
	fi

	echo "创建的分区:"
	echo "EFI分区: $FRZR_EFI_PART"
	echo "根分区: $FRZR_ROOT_PART"
}

function setup_dual_boot_filesystem() {
	mkdir -p "${MOUNT_PATH}"

	# 创建并格式化分区
	if ! mkfs.btrfs -L frzr_root -f "${FRZR_ROOT_PART}"; then
		echo "创建BTRFS文件系统失败"
		return 1
	fi

	if ! mkfs.vfat "${FRZR_EFI_PART}"; then
		echo "创建EFI文件系统失败"
		return 1
	fi

	if ! dosfslabel "${FRZR_EFI_PART}" frzr_efi; then
		echo "设置EFI分区标签失败"
		return 1
	fi

	# 挂载分区
	if ! mount -t btrfs -o nodatacow "${FRZR_ROOT_PART}" "${MOUNT_PATH}"; then
		echo "挂载根分区失败"
		return 1
	fi

	mkdir "${MOUNT_PATH}/boot"
	if ! mount -t vfat "${FRZR_EFI_PART}" "${MOUNT_PATH}/boot/"; then
		echo "挂载EFI分区失败"
		return 1
	fi

	# 创建BTRFS子卷
	if ! btrfs subvolume create "${MOUNT_PATH}/var"; then
		echo "创建var子卷失败"
		return 1
	fi

	if ! btrfs subvolume create "${MOUNT_PATH}/home"; then
		echo "创建home子卷失败"
		return 1
	fi

	# 设置目录结构
	mkdir -p "${MOUNT_PATH}/home/${USERNAME}"
	chown 1000:1000 "${MOUNT_PATH}/home/${USERNAME}"
	mkdir -p "${MOUNT_PATH}/etc"
	mkdir -p "${MOUNT_PATH}/.etc"

	echo "双系统文件系统设置完成"
}

function dual_boot_install() {
	local username="$1"
	USERNAME=${username:-gamer}

	echo "=== 双系统安装模式 ==="

	# 检测和显示现有系统
	detect_existing_systems
	show_system_info

	# 检查空间
	if ! check_unallocated_space; then
		if ! whiptail --yesno \
			"磁盘没有足够的未分配空间。\n\n是否要调整现有分区大小来安装？\n\n(选择'否'将退出并显示手动准备说明)" \
			10 60 3>&1 1>&2 2>&3; then

			# 简洁的手动说明
			echo ""
			echo "请手动准备至少55GiB未分配空间："
			echo "Windows: 磁盘管理 -> 压缩卷"
			echo "Linux: gparted 调整分区大小"
			echo "准备完成后重新运行此脚本"
			exit 1

		fi

		# 执行分区缩小，每一步都检查返回值
		if ! select_partition_to_shrink; then
			echo "分区选择失败" >&2
			exit 1
		fi

		if ! select_shrink_size; then
			echo "大小选择失败" >&2
			exit 1
		fi

		if ! shrink_selected_partition; then
			echo "分区操作失败" >&2
			exit 1
		fi

	else
		if ! whiptail --yesno \
			"检测到当前磁盘有足够的未分配空间。\n默认会使用当前磁盘的未分配空间来安装。\n\n是否继续？\n\n(选择'否'将退出安装)" \
			10 60 3>&1 1>&2 2>&3; then

			exit 1
		fi

	fi

	# 继续安装流程
	if ! create_dual_boot_partitions; then
		echo "创建分区失败" >&2
		exit 1
	fi

	if ! setup_dual_boot_filesystem; then
		echo "文件系统设置失败" >&2
		exit 1
	fi

	# 安装bootloader
	if ! bootctl --esp-path="${MOUNT_PATH}/boot/" install; then
		echo "bootloader安装失败" >&2
		exit 1
	fi

	echo "双系统文件系统设置完成" >&2
}

########## 主流程

function handle_installation_choice() {
	local username="$1"
	local install_type="$2"

	echo >&2 "handle_installation_choice username: $username, install_type: $install_type"

	# 选择安装类型
	local chosen_type=$(choose_install_type "$install_type")
	case "$chosen_type" in
	"fresh")
		echo "全新安装" >&2
		fresh_install "$username"
		;;
	"dual")
		echo "双系统安装" >&2
		dual_boot_install "$username"
		;;
	*)
		echo "无效的安装类型: $chosen_type" >&2
		exit 1
		;;
	esac
}

function main() {
	local username="$1"
	local disk="$2"
	local install_type="$3"

	# 1. 选择磁盘
	select_disk "$disk"

	# 2. 检查现有安装
	if check_existing_installation; then
		# 现有frzr安装 - 修复或重新安装
		local choice=$(choose_repair_or_reinstall)
		case "$choice" in
		"repair")
			repair_install
			;;
		"reinstall")
			# 进入常规安装类型选择
			handle_installation_choice "$username" "$install_type"
			;;
		"*")
			echo "取消安装" >&2
			exit 1
			;;
		esac
	else
		# 新安装 - 选择安装类型
		handle_installation_choice "$username" "$install_type"
	fi
}

# 执行主流程
main "$1" "$2" "$3"
