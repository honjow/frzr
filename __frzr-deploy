get_img_url() {
	local CHANNEL="$1"
	local current_major="${2:-}"
	local keywords="img|skosys"

	echo "CHANNEL: $CHANNEL" >&2

	# Preprocess: sort by date (newest first) + remove incomplete uploads
	local releases
	releases=$(jq 'sort_by(.created_at) | reverse |
		del(.[] | select(.assets[].state != "uploaded"))')

	# ── Find global stable release (prerelease==false) ──
	local stable_info stable_date="" stable_tag="" stable_url=""
	stable_info=$(_find_release "$releases" \
		'.[] | select(.prerelease==false)' "$keywords")
	if [ -n "$stable_info" ]; then
		_parse_release_info "$stable_info"
		stable_date="$_rel_date"; stable_tag="$_rel_tag"; stable_url="$_rel_url"
	else
		stable_date="1970-01-01T00:00:00Z"
	fi

	# ── Channel dispatch ──
	local result=""

	if [[ "$CHANNEL" =~ ^[0-9]+\-?[0-9]*$ ]]; then
		# Explicit version number (for downgrading)
		local ver_info
		ver_info=$(_find_release "$releases" \
			".[] | select(.prerelease==false) | select(.name|test(\" ${CHANNEL}\$\"))" "$keywords")
		[ -n "$ver_info" ] && { _parse_release_info "$ver_info"; result="$_rel_url"; }

	elif [ "$CHANNEL" == "stable" ]; then
		result="$stable_url"

	elif [ "$CHANNEL" == "testing" ]; then
		local test_info
		test_info=$(_find_release "$releases" \
			'.[] | select(.prerelease==true) | select(.name|test("\\[.*\\]")|not)' "$keywords")
		if [ -n "$test_info" ]; then
			_parse_release_info "$test_info"
			echo "testing_release_date: $_rel_date" >&2
			echo "stable_release_date: $stable_date" >&2
			if [ -n "$stable_url" ] && \
			   _should_use_stable "$_rel_date" "$stable_date" "$current_major" "$stable_tag"; then
				result="$stable_url"
			else
				result="$_rel_url"
			fi
		else
			result="$stable_url"
		fi

	else
		# ── Tagged channel (e.g. kde-core, gnome-nv) ──
		local CHANNEL_STABLE=""

		# If channel has a sub-variant suffix, find the stable variant
		if [[ "$CHANNEL" =~ -[^-]*$ ]]; then
			CHANNEL_STABLE=$(echo "${CHANNEL}" | sed 's/-[^-]*$//')
			echo "CHANNEL_STABLE: $CHANNEL_STABLE" >&2

			local ch_stable_info
			ch_stable_info=$(_find_release "$releases" \
				".[] | select(.name|test(\"\\\\[${CHANNEL_STABLE}\\\\]\"; \"i\"))" "$keywords")
			if [ -n "$ch_stable_info" ]; then
				_parse_release_info "$ch_stable_info"
				stable_date="$_rel_date"; stable_tag="$_rel_tag"; stable_url="$_rel_url"
			else
				echo "No stable channel found, pick some (old) values" >&2
				stable_date="1970-01-01T00:00:00Z"
				stable_url=""
			fi
		fi

		# Find the unstable/tagged release
		local unstable_info
		unstable_info=$(_find_release "$releases" \
			".[] | select(.prerelease==true) | select(.name|test(\"\\\\[${CHANNEL}\\\\]\"; \"i\"))" "$keywords")

		if [ -n "$unstable_info" ]; then
			_parse_release_info "$unstable_info"
			echo "unstable_release_date: $_rel_date" >&2
			echo "stable_release_date: $stable_date" >&2

			if [[ "$CHANNEL" == "unstable" || -n "$CHANNEL_STABLE" ]] && \
			   [ -n "$stable_url" ] && \
			   _should_use_stable "$_rel_date" "$stable_date" "$current_major" "$stable_tag"; then
				result="$stable_url"
			else
				result="$_rel_url"
			fi
		else
			result="$stable_url"
		fi
	fi

	echo $result
}

handle_multipart_image() {
	local base_file="$1"
	local base_name=$(basename "$base_file")
	local dir_name=$(dirname "$base_file")

	# Use extension-aware extraction to avoid truncating .from_xxx in .skdelta names
	local base_name_no_ext
	case "$base_name" in
		*.skdelta) base_name_no_ext="${base_name%.skdelta}" ;;
		*.skosys)  base_name_no_ext="${base_name%.skosys}" ;;
		*)         base_name_no_ext="${base_name%%.*}" ;;
	esac

	# Strip .partN-T suffix if the input file is itself a part file
	base_name_no_ext=$(echo "$base_name_no_ext" | sed 's/\.part[0-9]*-[0-9]*//')

	# 首先检查新格式（.partN-T）
	local first_part=$(find "$dir_name" -maxdepth 1 -type f -name "${base_name_no_ext}.part1-*.*" | head -n1)
	if [ -n "$first_part" ]; then
		# 获取去除部分（partN-T）的实际后缀名
		local real_ext=$(echo "$first_part" | sed "s/.*${base_name_no_ext}\.part1-[0-9]\+//")

		local merged_file_name="${dir_name}/${base_name_no_ext}${real_ext}"

		# 从文件名中提取总部分数
		local total_parts=$(echo "$first_part" | grep -o 'part1-[0-9]*' | cut -d'-' -f2)
		echo "Found multipart image with $total_parts parts (new format)" >&2

		# 检查所有部分是否存在
		local missing_parts=0
		for ((i = 1; i <= $total_parts; i++)); do
			if [ ! -f "${dir_name}/${base_name_no_ext}.part${i}-${total_parts}${real_ext}" ]; then
				echo "Missing part $i of $total_parts" >&2
				missing_parts=1
				break
			fi
		done

		if [ $missing_parts -eq 1 ]; then
			echo "Error: Some parts are missing" >&2
			return 1
		fi

		# 合并文件
		echo "Merging parts..." >&2
		: >"$merged_file_name" # 清空或创建目标文件
		for ((i = 1; i <= $total_parts; i++)); do
			cat "${dir_name}/${base_name_no_ext}.part${i}-${total_parts}${real_ext}" >>"$merged_file_name"
		done

		# 清理分包文件
		echo "Cleaning up part files..." >&2
		for ((i = 1; i <= $total_parts; i++)); do
			rm -f "${dir_name}/${base_name_no_ext}.part${i}-${total_parts}${real_ext}"
		done

		echo "$merged_file_name"
		return 0
	fi

	# 检查旧格式（-000）
	if [ -f "${base_file}-000" ]; then
		echo "Found split files (old format)" >&2
		echo "Merging split files..." >&2
		: >"$base_file" # 清空或创建目标文件
		cat ${base_file}-* >"$base_file"
		rm -f ${base_file}-*
		echo "Split files merge complete" >&2
		echo "$base_file"
		return 0
	fi

	# 不是分包文件，返回原文件名
	echo "$base_file"
	return 0
}

mk_swapfile() {
	SWAPFILE=${1:-}
	SWAPSIZE=${2:-}

	dd if=/dev/zero of="$SWAPFILE" bs=1M count="$SWAPSIZE"
	chmod 600 "$SWAPFILE"
	mkswap -U clear "$SWAPFILE"
}

create_swap() {
	local mount_path=${1}
	local deployment_dir=${2}

	local ram_info=$(dmidecode -t 17 | grep Size)
	local ram_size=$(echo "$ram_info" | awk '{sum += $2} END {print sum}')

	local available_space=$(df -B 1G --output=avail "$mount_path" | tail -n 1)
	local required_space=ram_size

	SWAPFILE="$mount_path/swap/swapfile"
	SWAPSIZE="${ram_size}GiB"

	# check swap subvolume
	if [ ! -d "$mount_path/swap" ]; then
		echo "$mount_path/swap does not exist. creating subvolume..."

		# create subvolume
		btrfs subvolume create $mount_path/swap
		chattr +C $mount_path/swap
	else
		# check if subvolume exists
		if btrfs subvolume show "$mount_path/swap" &>/dev/null; then
			echo "$mount_path/swap is a Btrfs subvolume."
		else
			echo "$mount_path/swap exists but is not a Btrfs subvolume."
			rm -rf $mount_path/swap
			btrfs subvolume create $mount_path/swap
			chattr +C $mount_path/swap
		fi
	fi

	# create swapfile
	echo "Creating swapfile..."
	if [ ! -f "$SWAPFILE" ]; then
		# btrfs filesystem mkswapfile --size "$ram_size"GiB "$mount_path/swap/swapfile"

		mk_swapfile "$SWAPFILE" "$SWAPSIZE"
	else
		echo "Swapfile appears to already exist"
		existing_file_type=$(file "$SWAPFILE" | cut -d' ' -f2-)
		if [[ "$existing_file_type" == *"Linux swap file"* ]]; then
			echo "Swapfile is a Linux swap file"
			if swapon --show | grep -q "$SWAPFILE"; then
				echo "Swapfile is already enabled"
			else
				echo "Enabling swapfile"
				swapon "$SWAPFILE"
				if [ $? -ne 0 ]; then
					echo "Failed to enable swapfile"
					rm -rf $SWAPFILE
					mk_swapfile "$SWAPFILE" "$SWAPSIZE"
				fi
			fi
		else
			echo "Swapfile exists but is not a Linux swap file"
			rm -rf $SWAPFILE
			mk_swapfile "$SWAPFILE" "$SWAPSIZE"
		fi
	fi
}

