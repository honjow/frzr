get_fallback_url_alist() {
	local img_file_name=$1
	local version_path=${2:-}
	local subdir=${3:-}
	local timeout=${4:-10}

	local fallback_base="https://ns.switchsystem.eu.org/d/vfs/guest/stos/img/"

	# 构建候选 URL 列表：优先新目录结构，回退旧扁平路径
	local candidates=()
	if [[ -n "$version_path" ]]; then
		if [[ -n "$subdir" ]]; then
			candidates+=("${fallback_base}${version_path}/${subdir}/${img_file_name}")
		else
			candidates+=("${fallback_base}${version_path}/${img_file_name}")
		fi
	fi
	candidates+=("${fallback_base}${img_file_name}")

	for image_url in "${candidates[@]}"; do
		local initial_code
		if initial_code=$(curl --http1.1 -s -o /dev/null -w "%{http_code}" -I \
			--connect-timeout 5 \
			--max-time "$timeout" \
			--retry 0 \
			"$image_url" 2>/dev/null); then
			if [[ "$initial_code" =~ ^30[1278]$ ]]; then
				echo "$image_url"
				return 0
			fi
		fi
	done
}

# 验证校验文件内容格式是否符合SHA256规范
validate_checksum_format() {
	local checksum_content="$1"

	# 检查内容是否为空
	if [[ -z "$checksum_content" ]]; then
		echo "校验文件内容为空" >&2
		return 1
	fi

	# 检查是否包含明显的错误信息
	if echo "$checksum_content" | grep -qi -E "(not found|error|<!DOCTYPE|<html|<head)" 2>/dev/null; then
		echo "校验文件包含错误信息或HTML内容" >&2
		return 1
	fi

	local valid_lines=0
	local total_lines=0

	# 逐行检查格式
	while IFS= read -r line || [[ -n "$line" ]]; do
		# 跳过空行和注释行
		if [[ -z "$line" ]] || [[ "$line" =~ ^[[:space:]]*# ]]; then
			continue
		fi

		total_lines=$((total_lines + 1))

		# 检查行格式：SHA256哈希值(64个十六进制字符) + 空格 + 文件名
		if [[ "$line" =~ ^[a-fA-F0-9]{64}[[:space:]]+[^[:space:]]+.*$ ]]; then
			valid_lines=$((valid_lines + 1))
		else
			echo "无效的校验文件行格式: $line" >&2
		fi
	done <<<"$checksum_content"

	# 至少需要有一行有效的校验信息
	if [[ $valid_lines -eq 0 ]]; then
		echo "校验文件中没有找到有效的SHA256校验行" >&2
		return 1
	fi

	# 如果有无效行，给出警告但不失败
	if [[ $valid_lines -lt $total_lines ]]; then
		echo "警告: 校验文件中有 $((total_lines - valid_lines)) 行格式不正确" >&2
	fi

	echo "校验文件格式验证通过，有效行数: $valid_lines" >&2
	return 0
}

# 尝试多个校验文件镜像站
try_checksum_mirrors() {
	local version_path="$1"
	local branch="$2"

	# 校验文件镜像站列表（按优先级顺序）
	local mirrors=(
		"https://gitee.com/honjow/sk-api-info/raw/master/sk-chimeraos/checksum/"
		"https://gitea.switchsystem.eu.org/honjow/sk-api-info/raw/branch/master/skorionos/checksum/"
		"https://raw.gitcode.com/honjow/sk-api-info/raw/master/skorionos/checksum/"
	)

	for mirror in "${mirrors[@]}"; do
		echo "尝试校验文件镜像站: ${mirror}" >&2

		local checksum_url="${mirror}${version_path}/sha256sum-${branch}.txt"
		echo "正在从镜像站获取校验文件: ${checksum_url}" >&2

		local content curl_status
		content=$(curl --http1.1 -L -s --connect-timeout 15 -m 15 "${checksum_url}" 2>/dev/null) || curl_status=$?
		curl_status=${curl_status:-0}
		if [[ $curl_status -eq 0 && -n "$content" ]]; then
			echo "镜像站校验文件获取成功，正在验证格式..." >&2
			if validate_checksum_format "$content"; then
				echo "镜像站 ${mirror} 校验文件格式验证通过" >&2
				echo "$content"
				return 0
			else
				echo "镜像站 ${mirror} 校验文件格式验证失败" >&2
			fi
		else
			echo "镜像站 ${mirror} 获取失败 (状态码: $curl_status)" >&2
		fi
	done

	echo "所有校验文件镜像站都失败，将使用原有方式" >&2
	return 1
}

# 尝试多个API镜像站
try_api_mirrors() {
	# API镜像站列表（按优先级顺序）
	local api_mirrors=(
		"https://gitee.com/honjow/sk-api-info/raw/master/sk-chimeraos/release.json"
		"https://gitea.switchsystem.eu.org/honjow/sk-api-info/raw/branch/master/skorionos/release.json"
