get_env_from_conf() {
	set -a
	for i in "${HOME}"/.config/environment.d/*.conf; do
		[[ -f "${i}" ]] && . "${i}"
	done

	# 获取 uid 1000 的用户目录
	home_dir=$(getent passwd 1000 2>/dev/null | cut -d: -f6)
	echo "Home directory: ${home_dir}"
	sleep 1
	if [[ -d "${home_dir}/.config/environment.d" ]]; then
		for i in "${home_dir}"/.config/environment.d/*.conf; do
			[[ -f "${i}" ]] && . "${i}"
		done
	fi
	set +a
}

function get_branch() {
	local deployment=$1
	# (chimeraos|skorionos)-48-8_624ba25-cosmic -> cosmic
	# (chimeraos|skorionos)-48-8_624ba25-kde-nv -> kde
	echo "$deployment" | awk -F '_' '{print $NF}' | awk -F '-' '{print $2}'
}

get_version_from_name() {
	local name=$1
	# (chimeraos|skorionos)-50-4_5d150d2-gnome-nv -> 50-4_5d150d2
	# (chimeraos|skorionos)-48-8_624ba25-cosmic -> 48-8_624ba25
	echo "$name" | sed -n 's/\(chimeraos\|skorionos\)-\([0-9]\+\(-[0-9]\+\)\?_[a-f0-9]\+\)-.*/\2/p'
}

get_frzr_release() {
	if [ -e /build_info ]; then
		cat /build_info | head -1
	fi
}

get_major_version() {
	local input="$1"
	if [[ "$input" =~ (chimeraos|skorionos)- ]]; then
		input=$(get_version_from_name "$input")
	fi
	echo "$input" | grep -oP '^\d+'
}

# Query releases JSON: returns "created_at|tag_name|url1 url2 ..." or empty
_find_release() {
	local json="$1"
	local filter="$2"
	local kw="${3:-img|skosys}"
	echo "$json" | jq -r --arg kw "$kw" \
		"[$filter] | first // empty |
		 .created_at + \"|\" + .tag_name + \"|\" +
		 ([.assets[] | select(.browser_download_url | test(\$kw))
		   | .browser_download_url] | join(\" \"))" 2>/dev/null
}

# Parse _find_release output into date/tag/url components
_parse_release_info() {
	local info="$1"
	_rel_date=$(echo "$info" | cut -d'|' -f1)
	_rel_tag=$(echo "$info" | cut -d'|' -f2)
	_rel_url=$(echo "$info" | cut -d'|' -f3)
}

# Decide whether to fallback from candidate to stable (time + major version guard)
_should_use_stable() {
	local candidate_date="$1"
	local stable_date="$2"
	local current_major="$3"
	local stable_tag="$4"

	local candidate_time stable_time
	candidate_time=$(date -d "$candidate_date" +%s)
	stable_time=$(date -d "$stable_date" +%s)

	echo "candidate_time: $candidate_time" >&2
	echo "stable_time: $stable_time" >&2

	# Candidate is newer than stable -> don't fallback
	[ "$candidate_time" -gt "$stable_time" ] && return 1

	# Version guard: don't fallback to a lower major version
	if [ -n "$current_major" ] && [ -n "$stable_tag" ]; then
		local stable_major
		stable_major=$(get_major_version "$stable_tag")
		if [ -n "$stable_major" ] && \
		   [ "$current_major" -gt "$stable_major" ] 2>/dev/null; then
			echo "Skip stable fallback: current($current_major) > stable($stable_major)" >&2
			return 1
		fi
	fi
	return 0
}

# ── Delta update support ──────────────────────────────────────────────

try_delta_manifest_mirrors() {
	local version_path="$1"
	local branch="$2"

	local mirrors=(
		"https://gitee.com/honjow/sk-api-info/raw/master/skorionos/delta/"
		"https://gitea.switchsystem.eu.org/honjow/sk-api-info/raw/branch/master/skorionos/delta/"
		"https://raw.gitcode.com/honjow/sk-api-info/raw/master/skorionos/delta/"
	)

	for mirror in "${mirrors[@]}"; do
		local manifest_url="${mirror}${version_path}/delta-manifest-${branch}.json"
		local content
		content=$(curl --http1.1 -L -s --connect-timeout 10 -m 10 "${manifest_url}" 2>/dev/null) || true
		echo "尝试 delta manifest 镜像站: ${manifest_url}" >&2
		if [[ -n "$content" ]] && echo "$content" | jq -e '.deltas' >/dev/null 2>&1; then
			DELTA_MANIFEST_SOURCE="mirror:${mirror}"
			echo "Delta manifest 镜像站获取成功" >&2
			echo "$content"
			return 0
		fi
	done
	return 1
}

try_get_delta_info() {
	local base_url="$1"
	local branch="$2"
	local baseline_path="$3"
	local version_path="$4"

	if ! command -v tar >/dev/null 2>&1; then
		DELTA_SKIP_REASON="tar not installed"
		return 1
	fi
	if ! command -v jq >/dev/null 2>&1; then
		DELTA_SKIP_REASON="jq not installed"
		return 1
	fi
	if [ ! -d "$baseline_path" ]; then
		DELTA_SKIP_REASON="no baseline directory (first deploy with delta support)"
		return 1
	fi

	local baseline_name
	baseline_name=$(ls -1 "$baseline_path" 2>/dev/null | head -1)
	if [ -z "$baseline_name" ]; then
		DELTA_SKIP_REASON="no baseline snapshot found"
		return 1
	fi
	local baseline_version
	baseline_version=$(get_version_from_name "$baseline_name")
	if [ -z "$baseline_version" ]; then
		DELTA_SKIP_REASON="cannot parse baseline version from: $baseline_name"
		return 1
	fi

	# Extract branch from baseline name and verify it matches target branch
	local baseline_branch
	baseline_branch=$(echo "$baseline_name" | sed -n 's/\(chimeraos\|skorionos\)-[0-9]\+\(-[0-9]\+\)\?_[a-f0-9]\+-//p')
	if [ -n "$baseline_branch" ] && [ "$baseline_branch" != "$branch" ]; then
		DELTA_SKIP_REASON="branch mismatch: baseline is ${baseline_branch}, target is ${branch}"
		return 1
	fi

	DELTA_MANIFEST_SOURCE=""
	local manifest=""
	if [[ "${ENABLE_DELTA_MIRRORS:-true}" == "true" ]]; then
		manifest=$(try_delta_manifest_mirrors "$version_path" "$branch") || true
	fi

	if [ -z "$manifest" ]; then
		local manifest_url="${base_url}/delta-manifest-${branch}.json"
		echo "尝试从 GitHub 获取 delta manifest: ${manifest_url}" >&2
		manifest=$(curl --http1.1 -L -s --connect-timeout 10 -m 10 "$manifest_url" 2>/dev/null) || true
		if [[ -n "$manifest" ]] && echo "$manifest" | jq -e '.deltas' >/dev/null 2>&1; then
			DELTA_MANIFEST_SOURCE="github:${base_url}"
			echo "GitHub delta manifest 获取成功" >&2
		else
			manifest=""
		fi
	fi

	if [ -z "$manifest" ]; then
		DELTA_SKIP_REASON="delta manifest not found for ${branch}"
		return 1
	fi
	if ! echo "$manifest" | jq -e '.deltas' >/dev/null 2>&1; then
		DELTA_SKIP_REASON="invalid delta manifest format"
		return 1
	fi

	local delta_info
	delta_info=$(echo "$manifest" | jq -r \
		--arg from "$baseline_version" \
		'.deltas[] | select(.from_version == $from)' 2>/dev/null)
	if [ -z "$delta_info" ]; then
		DELTA_SKIP_REASON="no delta from baseline ${baseline_version} in manifest"
		return 1
	fi

	DELTA_FILENAME=$(echo "$delta_info" | jq -r '.filename')
	DELTA_CHECKSUM=$(echo "$delta_info" | jq -r '.checksum' | sed 's/sha256://')
	DELTA_SIZE=$(echo "$delta_info" | jq -r '.size')
	DELTA_PARTS=$(echo "$delta_info" | jq -r '.parts // 1')
	DELTA_PART_CHECKSUMS=$(echo "$delta_info" | jq -r '(.part_checksums // []) | .[] | sub("sha256:"; "")' 2>/dev/null) || true
	DELTA_TARGET_META_HASH=$(echo "$delta_info" | jq -r '.target_meta_hash // ""')
	DELTA_FORMAT=$(echo "$delta_info" | jq -r '.format // "tar"')
	DELTA_BASELINE_NAME="$baseline_name"

	[ -n "$DELTA_FILENAME" ] && [ "$DELTA_FILENAME" != "null" ] || return 1
	return 0
}

# 解析增量包下载 URL：优先尝试 alist 镜像，失败回退到 GitHub
resolve_delta_url() {
	local base_url="$1"
	local filename="$2"
	local version_path="$3"

	if [[ "${enable_fallback_url:-true}" == "true" && -n "$version_path" ]]; then
		local mirror_url
		mirror_url=$(get_fallback_url_alist "$filename" "$version_path" "delta" 8)
		if [[ -n "$mirror_url" ]]; then
			echo "使用镜像下载 delta: ${mirror_url}" >&2
			echo "$mirror_url"
			return 0
		fi
	fi
	echo "${base_url}/${filename}"
}

try_delta_download() {
	local base_url="$1"
	local mount_path="$2"
	local delta_filename="$3"
	local delta_checksum="$4"
	local delta_parts="${5:-1}"
	local delta_part_checksums="$6"
	local version_path="${7:-}"

	local delta_filename_no_ext="${delta_filename%.skdelta}"

	if [ "$delta_parts" -gt 1 ]; then
		local i cs_idx=0
		local cs_array=()
		if [ -n "$delta_part_checksums" ]; then
			while IFS= read -r line; do
				cs_array+=("$line")
			done <<< "$delta_part_checksums"
		fi

		for i in $(seq 1 "$delta_parts"); do
			local part_file="${delta_filename_no_ext}.part${i}-${delta_parts}.skdelta"
			local part_url
			part_url=$(resolve_delta_url "$base_url" "$part_file" "$version_path")
			local part_cs="${cs_array[$cs_idx]:-}"

			echo "Downloading delta part ${i}/${delta_parts}: ${part_file}" >&2
			if ! download_file "$part_url" "$mount_path" "$part_file" \
				"$part_cs" "下载增量包 (${i}/${delta_parts})" "$((i - 1))" "$delta_parts"; then
				return 1
			fi
			cs_idx=$((cs_idx + 1))
		done

		local merged_file="${mount_path}/${delta_filename}"
		merged_file=$(handle_multipart_image "$merged_file")
		[ $? -eq 0 ] || return 1
		DELTA_IMG_FILE="$merged_file"
	else
		local delta_url
		delta_url=$(resolve_delta_url "$base_url" "$delta_filename" "$version_path")

		echo "Downloading delta: ${delta_filename}" >&2
		if ! download_file "$delta_url" "$mount_path" "$delta_filename" \
			"$delta_checksum" "下载增量包" 0 1; then
			return 1
		fi
		DELTA_IMG_FILE="${mount_path}/${delta_filename}"
	fi

	return 0
}

verify_delta_metadata() {
	local subvol="$1"
	local expected_hash="$2"

	if [ -z "$expected_hash" ]; then
		echo "No metadata hash in manifest, skipping verification" >&2
		return 0
	fi

	echo "Verifying deployment metadata..." >&2
	local actual_hash
	actual_hash=$(cd "$subvol" && find . -not -path './proc/*' -not -path './sys/*' -not -path './dev/*' -not -path './tmp/*' -not -path './run/*' \
		-not -type s \
		-printf '%P\t%s\t%m\t%U\t%G\t%y\n' 2>/dev/null | LC_ALL=C sort | sha256sum | awk '{print $1}')

	if [ "$actual_hash" != "$expected_hash" ]; then
		echo "Metadata verification failed!" >&2
		echo "  expected: $expected_hash" >&2
		echo "  actual:   $actual_hash" >&2
		return 1
	fi

	echo "Metadata verification passed" >&2
	return 0
}

reconcile_delta_filelist() {
	local target_subvol="$1"
	if [ -f "${target_subvol}/.delta-filelist" ]; then
		echo "Reconciling with target file list..." >&2
		local filelist
		filelist=$(mktemp)
		cp "${target_subvol}/.delta-filelist" "$filelist"
		rm -f "${target_subvol}/.delta-filelist"
		local actual_list
		actual_list=$(mktemp)
		(cd "${target_subvol}" && find . \
			-not -path './proc/*' -not -path './sys/*' -not -path './dev/*' \
			-not -path './tmp/*' -not -path './run/*' \
			-not -type s \
			-printf '%P\n' 2>/dev/null | LC_ALL=C sort > "$actual_list")
		local extra_count=0
		while IFS= read -r extra_file; do
			[ -z "$extra_file" ] && continue
			rm -rf "${target_subvol:?}/${extra_file}"
			extra_count=$((extra_count + 1))
		done < <(LC_ALL=C comm -23 "$actual_list" "$filelist")
		rm -f "$actual_list" "$filelist"
		if [ "$extra_count" -gt 0 ]; then
			echo "Removed $extra_count extra files from device baseline" >&2
		fi
	fi
}

try_delta_deploy() {
	local delta_file="$1"
	local baseline_snap="$2"
	local target_subvol="$3"
	local meta_hash="${4:-}"
	local format="${5:-tar}"

	btrfs subvolume snapshot "${baseline_snap}" "${target_subvol}" || return 1

	if [ "$format" = "rsync-batch" ]; then
		# === rsync-batch format ===
		local work_dir
		work_dir=$(mktemp -d)
		if ! xz -dc "${delta_file}" | tar xf - -C "$work_dir" 2>&1; then
			echo "Delta extraction failed" >&2
			rm -rf "$work_dir"
			btrfs subvolume delete "${target_subvol}" 2>/dev/null || true
			return 1
		fi

		if [ ! -f "$work_dir/batch" ]; then
			echo "rsync batch file not found in delta package" >&2
			rm -rf "$work_dir"
			btrfs subvolume delete "${target_subvol}" 2>/dev/null || true
			return 1
		fi

		echo "Applying rsync batch..." >&2
		if ! rsync -aAXH --numeric-ids --no-inc-recursive --delete \
			--read-batch="$work_dir/batch" "${target_subvol}/" 2>&1; then
			echo "rsync read-batch failed" >&2
			rm -rf "$work_dir"
			btrfs subvolume delete "${target_subvol}" 2>/dev/null || true
			return 1
		fi

		# Move filelist from work_dir to target for reconciliation
		if [ -f "$work_dir/.delta-filelist" ]; then
			cp "$work_dir/.delta-filelist" "${target_subvol}/.delta-filelist"
		fi
		rm -rf "$work_dir"
	else
		# === tar format ===
		if ! xz -dc "${delta_file}" | tar xf - --xattrs --acls --numeric-owner \
			--overwrite-dir -C "${target_subvol}" 2>&1; then
			echo "Delta extraction failed" >&2
			btrfs subvolume delete "${target_subvol}" 2>/dev/null || true
			return 1
		fi

		if [ -f "${target_subvol}/.delta-deletions" ]; then
			echo "Processing deletions..." >&2
			while IFS= read -r del_path; do
				[ -z "$del_path" ] && continue
				rm -rf "${target_subvol:?}/${del_path}"
			done < "${target_subvol}/.delta-deletions"
			rm -f "${target_subvol}/.delta-deletions"
		fi

		if [ -f "${target_subvol}/.delta-attrs" ]; then
			echo "Applying attribute changes..." >&2
			while IFS=$'\t' read -r attr_path attr_mode attr_uid attr_gid; do
				[ -z "$attr_path" ] && continue
				local full_path="${target_subvol}/${attr_path}"
				if [ -e "$full_path" ] || [ -L "$full_path" ]; then
					chmod "$attr_mode" "$full_path"
					chown "${attr_uid}:${attr_gid}" "$full_path"
				fi
			done < "${target_subvol}/.delta-attrs"
			rm -f "${target_subvol}/.delta-attrs"
		fi
		rm -f "${target_subvol}/.delta-meta.json"
	fi

	reconcile_delta_filelist "${target_subvol}"

	if ! verify_delta_metadata "${target_subvol}" "${meta_hash}"; then
		btrfs subvolume delete "${target_subvol}" 2>/dev/null || true
		return 1
	fi

	btrfs property set -ts "${target_subvol}" ro true || return 1
	return 0
}

create_baseline() {
	local mount_path="$1"
	local subvol="$2"
	local name="$3"
	local baseline_path="${mount_path}/baselines"

	mkdir -p "${baseline_path}"

	if [ -d "${baseline_path}" ]; then
		local old_bl
		for old_bl in $(ls -1 "${baseline_path}" 2>/dev/null); do
			if [ "${old_bl}" != "${name}" ]; then
				btrfs subvolume delete "${baseline_path}/${old_bl}" 2>/dev/null || true
			fi
		done
	fi

	if [ ! -e "${baseline_path}/${name}" ]; then
		btrfs subvolume snapshot -r "${subvol}" "${baseline_path}/${name}"
	fi
}

# ── End delta update support ──────────────────────────────────────────

main() {
	if [ $EUID -ne 0 ]; then
		echo "$(basename $0) must be run as root"
		exit 1
	fi

	FRZR_CHECK_UPDATE=0
	FRZR_STEAM_PROGRESS=0
	FRZR_SOURCE=""
	FRZR_PARAMS=""

	while (("$#")); do
		case $1 in
		--check)
			FRZR_CHECK_UPDATE=1
			shift
			;;
		--steam-progress)
			FRZR_STEAM_PROGRESS=1
			shift
			;;
		--* | -*)
			echo "Unknown argument $1"
			exit 1
			;;
		*)                               # preserve positional arguments
			FRZR_PARAMS="${FRZR_PARAMS}$1 " # Use trailing space for the match below
			shift
			;;
		esac
	done

	if [ ! -d /sys/firmware/efi/efivars ]; then
		echo "Legacy BIOS installs are not supported. Aborting."
		exit 1
	fi

	# keep only the first param as source
	FRZR_SOURCE="${FRZR_PARAMS%% *}"

	MOUNT_PATH=/frzr_root

	if ! mountpoint -q ${MOUNT_PATH}; then
		MOUNT_PATH=/tmp/frzr_root
	fi

	if ! mountpoint -q ${MOUNT_PATH}; then
		mkdir -p ${MOUNT_PATH}
		mount -L frzr_root ${MOUNT_PATH}
		sleep 5
	fi

	if ! mountpoint -q ${MOUNT_PATH}/boot && ls -1 /dev/disk/by-label | grep frzr_efi >/dev/null; then
		mkdir -p ${MOUNT_PATH}/boot
		mount -L frzr_efi ${MOUNT_PATH}/boot
		sleep 5
	fi

	DEPLOY_PATH=${MOUNT_PATH}/deployments
	mkdir -p ${DEPLOY_PATH}

	BOOT_CFG="${MOUNT_PATH}/boot/loader/entries/frzr.conf"
	mkdir -p ${MOUNT_PATH}/boot/loader/entries

	# delete deployments under these conditions:
	# - we are currently running inside a frzr deployment (i.e. not during install)
	# - the deployment is not currently running
	# - the deployment is not configured to be run on next boot
	if frzr-release >/dev/null; then
		CURRENT="$(frzr-release)"
		TO_DELETE=$(get_deployment_to_delete ${CURRENT} ${BOOT_CFG} ${DEPLOY_PATH})

		TO_DELETE_BOOT=$(get_boot_to_delete ${CURRENT} ${BOOT_CFG} ${MOUNT_PATH}/boot)

	if [ -n "${TO_DELETE}" ]; then
		for deployment in ${TO_DELETE}; do
			echo "deleting ${deployment}..."
			rm -rf "${MOUNT_PATH}/boot/${deployment}" || true
			btrfs subvolume delete "${DEPLOY_PATH}/${deployment}" || true
		done
	fi

	if [ -n "${TO_DELETE_BOOT}" ]; then
		for boot_entry in ${TO_DELETE_BOOT}; do
			echo "deleting boot entry ${boot_entry}..."
			rm -rf "${MOUNT_PATH}/boot/${boot_entry}" || true
		done
	fi

	rm -f ${MOUNT_PATH}/boot/*.img.tmp || true
	sync
	fi

	if [ -n "$FRZR_SOURCE" ] && [ "$FRZR_SOURCE" != " " ] &&
		[ $FRZR_CHECK_UPDATE -eq 0 ] && [ $FRZR_STEAM_PROGRESS -eq 0 ] &&
		[ -z "${local_install}" ]; then
		if [[ ! "$FRZR_SOURCE" =~ \.img(\.tar\.xz|\.xz|\.zst)?|\.skosys$|\.skdelta$ ]]; then
			echo "$FRZR_SOURCE" >"${MOUNT_PATH}/source"
		else
			base_name=$(basename "${FRZR_SOURCE}")
			# base_name: (chimeraos|skorionos)-48-8_624ba25-gnome-nv.img.tar.xz
			base_name_without_ext="${base_name%%.*}"
			# base_name_without_ext: (chimeraos|skorionos)-48-8_624ba25-gnome-nv, get gnome-nv
			suffix=$(echo "$base_name_without_ext" | sed 's/.*[0-9]_[^-]*-//')
			source="${DEFAULT_REPO}:${DEFAULT_BRANCH}:${suffix}"
			echo "$source" >"${MOUNT_PATH}/source"
		fi
	fi

	if [ -e "${MOUNT_PATH}/source" ]; then
		SOURCE=$(cat "${MOUNT_PATH}/source" | head -1)
	else
		echo "WARNING: source wasn't specified, using default source: ${DEFAULT_SOURCE}"
		SOURCE="${DEFAULT_SOURCE}"
	fi

	DELTA_SUCCESS=false

	if [ "${local_install}" == true ]; then
		# install from local disk where label is "FRZR_UPDATE"
		echo "Installing from local disk..." >&2
		mkdir -p /root/tmp_source
		if mountpoint -q /root/tmp_source; then
			umount /root/tmp_source
		fi

		# get all FRZR_UPDATE devices
		FRZR_DEVICES=$(lsblk -rno "path,label" | grep "FRZR_UPDATE" | awk '{print $1}')
		if [ -z "$FRZR_DEVICES" ]; then
			echo "No FRZR_UPDATE device found" >&2
			exit 1
		fi

		# prefer mapper device, fallback to first device if no mapper found
		if echo "$FRZR_DEVICES" | grep -q "^/dev/mapper/"; then
			FRZR_DEV=$(echo "$FRZR_DEVICES" | grep "^/dev/mapper/" | head -1)
		else
			echo "No mapper device found, use the first device" >&2
			FRZR_DEV=$(echo "$FRZR_DEVICES" | head -1)
		fi

		if [ -z "$FRZR_DEV" ]; then
			echo "No FRZR_UPDATE device found" >&2
			exit 1
		fi

		echo "Using device: $FRZR_DEV"
		mount -o rw "$FRZR_DEV" /root/tmp_source

		# find the matching file - prefer .skdelta for smaller updates
		local usb_delta_file=""
		usb_delta_file=$(find /root/tmp_source -maxdepth 1 -type f -name "*.skdelta" | head -n1) || true

		if [ -n "$usb_delta_file" ]; then
			echo "Found delta file on USB: $(basename "$usb_delta_file")" >&2
			usb_delta_file=$(handle_multipart_image "$usb_delta_file")
			local usb_meta=""
			usb_meta=$(xz -dc "$usb_delta_file" | tar xf - -O .delta-meta.json 2>/dev/null) || true
			if [ -n "$usb_meta" ]; then
				local usb_from_ver usb_target_name usb_baseline
				usb_from_ver=$(echo "$usb_meta" | jq -r '.from_version')
				usb_target_name=$(echo "$usb_meta" | jq -r '.target_name // ""')
				BASELINE_PATH="${MOUNT_PATH}/baselines"
				usb_baseline=""
				if [ -d "$BASELINE_PATH" ]; then
					usb_baseline=$(find "$BASELINE_PATH" -maxdepth 1 -type d -name "*${usb_from_ver}*" | head -1)
				fi
				if [ -n "$usb_baseline" ]; then
					DELTA_FORMAT=$(echo "$usb_meta" | jq -r '.format // "tar"')
					DELTA_TARGET_META_HASH=$(echo "$usb_meta" | jq -r '.target_meta_hash // ""')
					if [ -n "$usb_target_name" ] && [ "$usb_target_name" != "null" ]; then
						NAME="$usb_target_name"
					else
						NAME=$(basename "$usb_delta_file" .skdelta | sed 's/\.from_.*//')
					fi
					SUBVOL="${DEPLOY_PATH}/${NAME}"
					echo "Applying USB delta: $(basename "$usb_baseline") -> $NAME (format: $DELTA_FORMAT)" >&2
					if try_delta_deploy "$usb_delta_file" "$usb_baseline" "$SUBVOL" \
						"$DELTA_TARGET_META_HASH" "$DELTA_FORMAT"; then
						DELTA_SUCCESS=true
						echo "USB delta update applied successfully" >&2
					else
						echo "USB delta deploy failed, falling back to full image" >&2
					fi
				else
					echo "No matching baseline for USB delta (need: $usb_from_ver), trying full image" >&2
				fi
			else
				echo "USB delta has no embedded metadata, trying full image" >&2
			fi
		fi

		if [ "$DELTA_SUCCESS" != "true" ]; then
			if IMG_FILE=$(find /root/tmp_source -maxdepth 1 -type f -regex ".*\.img\(\.tar\.xz\|\.xz\|\.zst\)\?$\|.*\.skosys$" | head -n1) && [ -n "$IMG_FILE" ]; then
				FILE_NAME=$(basename "${IMG_FILE}")
				NAME=$(echo "${FILE_NAME}" | cut -f 1 -d '.')
				SUBVOL="${DEPLOY_PATH}/${NAME}"
			else
				echo "No valid image file found in FRZR_UPDATE partition"
				exit 1
			fi
		fi

	elif [[ "$FRZR_SOURCE" =~ \.skdelta$ ]]; then
		echo "Using local delta file: ${FRZR_SOURCE}" >&2
		local DELTA_FILE="${FRZR_SOURCE}"

		if [ ! -f "$DELTA_FILE" ]; then
			echo "Delta file not found: $DELTA_FILE" >&2
			exit 1
		fi

		DELTA_FILE=$(handle_multipart_image "$DELTA_FILE")

		local meta_json=""
		meta_json=$(xz -dc "$DELTA_FILE" | tar xf - -O .delta-meta.json 2>/dev/null) || true
		if [ -z "$meta_json" ]; then
			echo "No .delta-meta.json in delta package (old format without embedded metadata)" >&2
			exit 1
		fi

		DELTA_FORMAT=$(echo "$meta_json" | jq -r '.format // "tar"')
		local from_version
		from_version=$(echo "$meta_json" | jq -r '.from_version')
		local target_name_from_meta
		target_name_from_meta=$(echo "$meta_json" | jq -r '.target_name // ""')
		DELTA_TARGET_META_HASH=$(echo "$meta_json" | jq -r '.target_meta_hash // ""')

		if [ -n "$target_name_from_meta" ] && [ "$target_name_from_meta" != "null" ]; then
			NAME="$target_name_from_meta"
		else
			NAME=$(basename "$DELTA_FILE" .skdelta | sed 's/\.from_.*//')
		fi
		SUBVOL="${DEPLOY_PATH}/${NAME}"

		BASELINE_PATH="${MOUNT_PATH}/baselines"
		local baseline=""
		if [ -d "$BASELINE_PATH" ]; then
			baseline=$(find "$BASELINE_PATH" -maxdepth 1 -type d -name "*${from_version}*" | head -1)
		fi
		if [ -z "$baseline" ]; then
			echo "No matching baseline for version ${from_version}" >&2
			echo "Available baselines:" >&2
			ls -1 "$BASELINE_PATH" 2>/dev/null || echo "  (none)" >&2
			exit 1
		fi

		echo "  Baseline: $(basename "$baseline")" >&2
		echo "  Target:   $NAME" >&2
		echo "  Format:   $DELTA_FORMAT" >&2

		if ! try_delta_deploy "$DELTA_FILE" "$baseline" "$SUBVOL" \
			"$DELTA_TARGET_META_HASH" "$DELTA_FORMAT"; then
			echo "Delta deploy failed" >&2
			exit 1
		fi
		DELTA_SUCCESS=true
		echo "Offline delta update applied successfully" >&2

	elif [[ "$FRZR_SOURCE" =~ \.img(\.tar\.xz|\.xz|\.zst)?|\.skosys$ ]]; then
		echo "Using local image file: ${FRZR_SOURCE}" >&2
		FILE_NAME=$(basename ${FRZR_SOURCE})
		NAME=$(echo "${FILE_NAME}" | cut -f 1 -d '.')
		SUBVOL="${DEPLOY_PATH}/${NAME}"
		IMG_FILE=${FRZR_SOURCE}
	else
		echo "Using remote image file: ${SOURCE}" >&2
		REPO=$(echo "${SOURCE}" | cut -f 1 -d ':')
		CHANNEL=$(echo "${SOURCE}" | cut -f 2 -d ':')
		BRANCH=$(echo "${SOURCE}" | cut -f 3 -d ':')

		RELEASES_API_URL="https://api.github.com/repos/${REPO}/releases?per_page=50"

		# 设置默认值
		enable_api_cdn="false"
		enable_release_cdn="false"
		enable_fallback_url="true"
		enable_gitee_api="true"
		enable_gitee_checksum="true"

		FRZR_SK_CONFIG="/etc/frzr-sk.conf"
		if [ -f "${FRZR_SK_CONFIG}" ]; then
			enable_api_cdn=$(get_conf_value "${FRZR_SK_CONFIG}" "Download" "api_cdn")
			enable_release_cdn=$(get_conf_value "${FRZR_SK_CONFIG}" "Download" "release_cdn")
			enable_fallback_url=$(get_conf_value "${FRZR_SK_CONFIG}" "Download" "fallback_url")
			enable_gitee_api=$(get_conf_value "${FRZR_SK_CONFIG}" "Download" "gitee_api")
			enable_gitee_checksum=$(get_conf_value "${FRZR_SK_CONFIG}" "Download" "gitee_checksum")

			# 如果配置文件中的值为空，使用默认值
			[[ -z "$enable_api_cdn" ]] && enable_api_cdn="false"
			[[ -z "$enable_release_cdn" ]] && enable_release_cdn="false"
			[[ -z "$enable_fallback_url" ]] && enable_fallback_url="true"
			[[ -z "$enable_gitee_api" ]] && enable_gitee_api="true"
			[[ -z "$enable_gitee_checksum" ]] && enable_gitee_checksum="true"
		fi

		# echo "配置加载: API CDN=${enable_api_cdn}, Release CDN=${enable_release_cdn}, Fallback=${enable_fallback_url}, Gitee API=${enable_gitee_api}, Gitee 校验=${enable_gitee_checksum}" >&2

		ENABLE_DELTA_MIRRORS="$enable_gitee_api"

		GITHUB_CDN_FILE="/etc/github_cdn.conf"
		if [ -f "${GITHUB_CDN_FILE}" ]; then
			api_cdns=($(get_conf_value "${GITHUB_CDN_FILE}" "api" "server"))
			if [[ -n "${api_cdns}" && "$enable_api_cdn" == "true" ]]; then
				API_CND=$(get_random_value "${api_cdns[@]}")
				echo "# API: ${API_CND} #"
				RELEASES_API_URL="${API_CND}/repos/${REPO}/releases"
			fi
		fi

		# get environment variables from $HOME/.config/environment.d/*.conf
		get_env_from_conf || true

		if [[ -n "$GITHUB_TOKEN" ]]; then
			# 脱敏处理 只显示前 8 位，后面用 * 代替
			token_with_mask=$(echo "${GITHUB_TOKEN}" | sed 's/./\*/9g')
			echo "Using GitHub token: ${token_with_mask}" >&2
			HEADER="Authorization: Bearer ${GITHUB_TOKEN}"
			HEAD_FLAG="-H"
		fi

		set +e
		set +x

		# 优先尝试API镜像站
		if [[ "$enable_gitee_api" == "true" ]]; then
			RELEASES=$(try_api_mirrors)
			if [[ $? -eq 0 && -n "$RELEASES" ]]; then
				status=0
			else
				RELEASES=""
			fi
		fi

		# 如果API镜像站失败或未启用，使用原有的 GitHub API
		if [[ -z "$RELEASES" ]]; then
			echo "正在从 GitHub 获取发布信息: ${RELEASES_API_URL}" >&2
			if [[ -n "$HEADER" ]]; then
				RELEASES=$(curl --http1.1 -L -s --connect-timeout 15 -m 15 $HEAD_FLAG "${HEADER}" "${RELEASES_API_URL}")
			else
				RELEASES=$(curl --http1.1 -L -s --connect-timeout 15 -m 15 "${RELEASES_API_URL}")
			fi
			status=$?
		fi
		set -e
		if [[ -n "${DEBUG}" ]]; then
			set -x
		fi
		case $status in
		28)
			echo "Failed to fetch releases: Connection timed out"
			exit $status
			;;
		35)
			echo "Failed to fetch releases: SSL connect error"
			exit $status
			;;
		0) ;;
		*)
			echo "Failed to fetch releases, status code: $status"
			exit $status
			;;
		esac

		set +x
		# 检查token是否失效
		if echo "$RELEASES" | jq -e '.status == "401"' >/dev/null 2>&1; then
			echo "GitHub token invalid, retrying without authentication..." >&2
			unset GITHUB_TOKEN HEADER HEAD_FLAG
			RELEASES=$(curl --http1.1 -L -s --connect-timeout 15 -m 15 "${RELEASES_API_URL}")
		fi

		if echo "$RELEASES" | grep -q "API rate limit"; then
			echo "GitHub API rate limit exceeded"
			exit 29
		fi

		# Ensure the latest stable release is included even when
		# recent releases are all prereleases.
		if ! echo "$RELEASES" | jq -e '.[] | select(.prerelease==false)' >/dev/null 2>&1; then
			local latest_url="https://api.github.com/repos/${REPO}/releases/latest"
			echo "No stable release in list, fetching latest: ${latest_url}" >&2
			local latest_rel=""
			if [[ -n "$HEADER" ]]; then
				latest_rel=$(curl --http1.1 -L -s --connect-timeout 15 -m 15 $HEAD_FLAG "${HEADER}" "${latest_url}" 2>/dev/null) || true
			else
				latest_rel=$(curl --http1.1 -L -s --connect-timeout 15 -m 15 "${latest_url}" 2>/dev/null) || true
			fi
			if [[ -n "$latest_rel" ]] && echo "$latest_rel" | jq -e '.tag_name' >/dev/null 2>&1; then
				RELEASES=$(echo "$RELEASES" "$latest_rel" | jq -s '.[0] + [.[1]]')
				echo "Latest stable release appended" >&2
			fi
		fi

		local current_major=""
		local cur_rel
		cur_rel=$(get_frzr_release)
		[ -n "$cur_rel" ] && current_major=$(get_major_version "$cur_rel")

		IMG_LIST_URL=$(echo $RELEASES | get_img_url "${CHANNEL}" "${current_major}")
		if [[ -n "${DEBUG}" ]]; then
			set -x
		fi
		# echo "IMG_LIST_URL: ${IMG_LIST_URL}" >&2

		# if [ -f "${GITHUB_CDN_FILE}" ]; then
		# 	img_cdns=($(get_conf_value "${GITHUB_CDN_FILE}" "release" "server"))
		# 	if [[ -n "${img_cdns}" && "$enable_release_cdn" == "true" ]]; then
		# 		IMG_CND=$(get_random_value "${img_cdns[@]}")
		# 		echo "# Release: ${IMG_CND} #"
		# 		IMG_LIST_URL=$(echo "${IMG_LIST_URL}" | sed "s#^https://.*/${REPO}#${IMG_CND}/${REPO}#")
		# 	fi
		# fi

		if [[ "$enable_release_cdn" == "true" ]]; then
			if [[ -f "${GITHUB_CDN_FILE}" ]]; then
				img_cdns=($(get_conf_value "${GITHUB_CDN_FILE}" "release" "server"))
				if [[ ${#img_cdns[@]} -gt 0 ]]; then
					for img_cdn in "${img_cdns[@]}"; do
						echo "img_cdn: ${img_cdn}" >&2
					done
					IMG_CND=$(get_random_value "${img_cdns[@]}")
					echo "# Release: ${IMG_CND} #"
				fi
				IMG_LIST_URL=$(echo "${IMG_LIST_URL}" | sed "s#^https://.*/${REPO}#${IMG_CND}/${REPO}#")
			fi
		fi

		if [ -z "$IMG_LIST_URL" ] || [[ "$IMG_LIST_URL" =~ "null" ]]; then
			echo "No matching source found, IMG_LIST_URL: ${IMG_LIST_URL}"
			# set +x
			# if curl --http1.1 -L -s --connect-timeout 15 -m 15 "${RELEASES_API_URL}" | grep "rate limit" >/dev/null; then
			# 	echo "GitHub API rate limit exceeded"
			# 	exit 29
			# fi
			# if [[ -n "${DEBUG}" ]]; then
			# 	set -x
			# fi
			exit 1
		fi

		BASE_URL=$(dirname "$(echo "${IMG_LIST_URL}" | cut -d' ' -f1)")

		echo "BASE_URL: ${BASE_URL}" >&2

		# 优先尝试镜像站校验文件
		IMG_LIST_STR=""
		if [[ "$enable_gitee_checksum" == "true" ]]; then
			VERSION_PATH=$(basename "${BASE_URL}")

			echo "VERSION_PATH: ${VERSION_PATH}, BRANCH: ${BRANCH}" >&2

			if [[ -n "$VERSION_PATH" && -n "$BRANCH" ]]; then
				local checksum_status=0
				IMG_LIST_STR=$(try_checksum_mirrors "$VERSION_PATH" "$BRANCH") || checksum_status=$?
				if [[ $checksum_status -ne 0 ]]; then
					IMG_LIST_STR=""
				fi
			else
				echo "无法解析版本路径，跳过镜像站校验文件 [${VERSION_PATH}] [${BRANCH}]" >&2
			fi
		fi

		# 如果镜像站校验文件失败或未启用，使用原有方法
		if [[ -z "$IMG_LIST_STR" ]] || echo "$IMG_LIST_STR" | grep -q "not found"; then
			if [ -n "$BRANCH" ]; then
				CHECKSUM_URL="${BASE_URL}/sha256sum-${BRANCH}.txt"
				echo "正在从原始源获取校验文件: ${CHECKSUM_URL}" >&2
				IMG_LIST_STR="$(curl --http1.1 -L -s --connect-timeout 15 -m 15 ${CHECKSUM_URL})"
			else
				CHECKSUM_URL="${BASE_URL}/sha256sum.txt"
				echo "正在从原始源获取校验文件: ${CHECKSUM_URL}" >&2
				IMG_LIST_STR="$(curl --http1.1 -L -s --connect-timeout 15 -m 15 ${CHECKSUM_URL})"
			fi
		fi

		echo "$IMG_LIST_STR" >&2
		CHECKSUM_LIST=$(echo "$IMG_LIST_STR" | awk '{print $1}')
		# echo -e "CHECKSUM_LIST: \n${CHECKSUM_LIST}" >&2

		# 筛选包含BRANCH的URL
		if [ -n "$BRANCH" ]; then
			if echo "$IMG_LIST_URL" | grep -q "\-${BRANCH}\."; then
				FILTERED_URLS=$(echo "$IMG_LIST_URL" | tr ' ' '\n' | grep -i "\-${BRANCH}\.")
			else
				echo "没有找到包含 '$BRANCH' 的URL" >&2
			fi

			echo -e "原始下载URL: \n${FILTERED_URLS}" >&2

			# 选择第一个匹配的URL
			SELECTED_URL=$(echo "$FILTERED_URLS" | head -n 1)

			if [ -z "$SELECTED_URL" ]; then
				echo "警告: 没有找到包含 '$BRANCH' 的URL，使用原始URL列表的第一个URL" >&2
				SELECTED_URL=$(echo "$IMG_LIST_URL" | cut -d' ' -f1)
			fi
		else
			# 如果没有指定BRANCH，使用第一个URL
			SELECTED_URL=$(echo "$IMG_LIST_URL" | cut -d' ' -f1)
		fi

		IMG_FILE_NAME=$(basename ${SELECTED_URL} | sed 's/-[0-9]*$//')
		NAME=$(echo "${IMG_FILE_NAME}" | cut -f 1 -d '.')
		SUBVOL="${DEPLOY_PATH}/${NAME}"
		IMG_FILE="${MOUNT_PATH}/${IMG_FILE_NAME}"
		DELTA_SUCCESS=false

		SER=0
		TOTAL=$(echo "$CHECKSUM_LIST" | wc -l)

		# ── Check for existing install ──
		if [ -e "${SUBVOL}" ]; then
			echo "${NAME} already installed; aborting"
			exit 7
		fi

		# ── Gather delta update info (query only, no download) ──
		BASELINE_PATH="${MOUNT_PATH}/baselines"
		VERSION_PATH_DELTA=$(basename "${BASE_URL}")
		DELTA_AVAILABLE=false
		DELTA_SKIP_REASON=""

		if try_get_delta_info "$BASE_URL" "$BRANCH" "$BASELINE_PATH" "$VERSION_PATH_DELTA" 2>&1 >&2; then
			DELTA_AVAILABLE=true
		fi

		# ── Gather fallback download URL ──
		fallback_msg=""
		if [[ "$enable_fallback_url" == "true" ]]; then
			for CHECKSUM in $CHECKSUM_LIST; do
				FILE_NAME=$(echo "$IMG_LIST_STR" | grep $CHECKSUM | awk '{print $2}')
				FALLBACK_URL_AL=$(get_fallback_url_alist "${FILE_NAME}" "${VERSION_PATH:-}")
				if [[ -n "$FALLBACK_URL_AL" ]]; then
					FALLBACK_URL="${FALLBACK_URL_AL}"
					fallback_msg="(alist)"
					echo "使用备用下载 URL: ${FALLBACK_URL}" >&2
				else
					FALLBACK_URL=""
				fi
			done
		fi

		# ── --check mode: display info and exit ──
		if [ $FRZR_CHECK_UPDATE -eq 1 ]; then
			local SEP=$'\t'
			local check_output="${NAME}"

			# Calculate full image size from release API JSON
			local file_names
			file_names=$(echo "$IMG_LIST_STR" | awk '{print $2}')
			local full_size
			full_size=$(echo "$RELEASES" | jq -r --arg names "$file_names" '
				($names | split("\n") | map(select(. != ""))) as $fnames |
				[.[] | .assets[]? | select(.name as $n | $fnames | any(. == $n)) | .size] | add // 0
			' 2>/dev/null || echo "0")
			local full_size_hr
			full_size_hr=$(numfmt --to=iec ${full_size:-0} 2>/dev/null || echo "?")

			if [ "$DELTA_AVAILABLE" = true ]; then
				local delta_size_hr
				delta_size_hr=$(numfmt --to=iec ${DELTA_SIZE:-0} 2>/dev/null || echo "${DELTA_SIZE:-unknown}")
				echo "Delta update available:" >&2
				echo "  File: ${DELTA_FILENAME}" >&2
				echo "  Size: ${delta_size_hr}" >&2
				echo "  From: ${DELTA_BASELINE_NAME} -> ${NAME}" >&2
				echo "  Format: ${DELTA_FORMAT:-tar}" >&2
				echo "  Parts: ${DELTA_PARTS:-1}" >&2
				if [ -n "${DELTA_MANIFEST_SOURCE:-}" ]; then
					echo "  Manifest source: ${DELTA_MANIFEST_SOURCE}" >&2
				fi
				if [ "${DELTA_SIZE:-0}" -gt 0 ] 2>/dev/null; then
					check_output="${check_output}${SEP}(Δ${SEP}${delta_size_hr})"
				else
					check_output="${check_output}${SEP}(Δ)"
				fi
			else
				echo "No delta update available: ${DELTA_SKIP_REASON:-unknown reason}" >&2
				if [ "${full_size:-0}" -gt 0 ] 2>/dev/null; then
					check_output="${check_output}${SEP}(Σ${SEP}${full_size_hr})"
				else
					check_output="${check_output}${SEP}(Σ)"
				fi
			fi

			if [ -n "${fallback_msg}" ]; then
				check_output="${check_output}${SEP}${fallback_msg}"
			fi

			echo "${check_output}"
			exit 0 # let Steam know there is an update available
		fi

		# ── Try delta update (deploy mode only) ──
		if [ "$DELTA_AVAILABLE" = true ]; then
			echo "Delta update available: ${DELTA_FILENAME} ($(numfmt --to=iec ${DELTA_SIZE:-0} 2>/dev/null || echo "${DELTA_SIZE}") vs full)" >&2

			DELTA_IMG_FILE=""
			if try_delta_download "$BASE_URL" "$MOUNT_PATH" \
				"$DELTA_FILENAME" "$DELTA_CHECKSUM" "$DELTA_PARTS" "$DELTA_PART_CHECKSUMS" \
				"${VERSION_PATH_DELTA:-}"; then
				:
			fi

			if [ -n "$DELTA_IMG_FILE" ] && [ -f "$DELTA_IMG_FILE" ]; then
				local actual_cs
				actual_cs=$(sha256sum "$DELTA_IMG_FILE" | awk '{print $1}')
				if [ "$actual_cs" = "$DELTA_CHECKSUM" ]; then
					echo "Delta checksum verified, applying (format: ${DELTA_FORMAT:-tar})..." >&2
					if try_delta_deploy "$DELTA_IMG_FILE" \
						"${BASELINE_PATH}/${DELTA_BASELINE_NAME}" "${SUBVOL}" \
						"${DELTA_TARGET_META_HASH:-}" "${DELTA_FORMAT:-tar}"; then
						DELTA_SUCCESS=true
						echo "Delta update applied successfully" >&2
					else
						echo "Delta deploy failed, falling back to full update" >&2
					fi
				else
					echo "Delta checksum mismatch, falling back to full update" >&2
				fi
				rm -f "$DELTA_IMG_FILE"
			else
				echo "Delta download failed, falling back to full update" >&2
			fi

			rm -f "${MOUNT_PATH}"/*.skdelta 2>/dev/null || true
		fi
		# ── End delta attempt ──

		if [ "$DELTA_SUCCESS" != "true" ]; then
		for CHECKSUM in $CHECKSUM_LIST; do

			FILE_NAME=$(echo "$IMG_LIST_STR" | grep $CHECKSUM | awk '{print $2}')
			SUB_IMG_URL="${BASE_URL}/${FILE_NAME}"

			if [[ "$enable_fallback_url" == "true" ]]; then
				FALLBACK_URL_AL=$(get_fallback_url_alist "${FILE_NAME}" "${VERSION_PATH:-}")
				if [[ -n "$FALLBACK_URL_AL" ]]; then
					FALLBACK_URL="${FALLBACK_URL_AL}"
				else
					FALLBACK_URL=""
				fi
			fi

			if [[ -n "$FALLBACK_URL" ]]; then
				echo "备用下载 URL: ${FALLBACK_URL}" >&2
				SUB_IMG_URL="${FALLBACK_URL}"
			fi

			if [ -e ${SUBVOL} ]; then
				echo "${NAME} already installed; aborting"
				exit 7
			fi

			echo "Downloading ${NAME} ($((SER + 1))/${TOTAL})..."

			if ! download_file "$SUB_IMG_URL" "$MOUNT_PATH" "$FILE_NAME" \
				"$CHECKSUM" "下载系统镜像 (${NAME})" "$SER" "$TOTAL"; then
				echo "checksum does not match; aborting"
				exit 1
			fi

			SER=$((SER + 1))
		done
		fi # end DELTA_SUCCESS check (full download path)
	fi

	if [ "$DELTA_SUCCESS" != "true" ]; then
		if [ -z ${SHOW_UI} ]; then
			echo "installing ${NAME}..."
		else
			whiptail --infobox "提取并安装系统镜像 (${NAME}), 这可能需要一些时间。" 10 50 3>&1 1>&2 2>&3
		fi

		# 处理分包镜像文件
		IMG_FILE=$(handle_multipart_image "${IMG_FILE}")
		if [ $? -ne 0 ]; then
			echo "Error handling multipart image" >&2
			exit 1
		fi
	fi

	# 先检查是否存在匹配项
	CURRENT_RELEASE=$(get_frzr_release)
	if btrfs subvolume list ${MOUNT_PATH} 2>/dev/null | grep -q -E "deployments/(chimeraos|skorionos)"; then
		current_deploys_array=($(btrfs subvolume list ${MOUNT_PATH} | grep -E "deployments/(chimeraos|skorionos)" | awk '{print $9}'))
		for current_deploy in "${current_deploys_array[@]}"; do
			if [ "${current_deploy}" == "deployments/${CURRENT_RELEASE}" ]; then
				continue
			fi
			if [ "${current_deploy}" == "deployments/${NAME}" ]; then
				continue
			fi
			echo "current_deploy: ${current_deploy}, remove it..." >&2
			btrfs subvolume delete "${MOUNT_PATH}/${current_deploy}" || true
		done
	fi

	if [ "$DELTA_SUCCESS" != "true" ]; then
		echo "deploying ${IMG_FILE} to ${DEPLOY_PATH}" >&2

		if [[ "${IMG_FILE##*.}" == "img" ]]; then
			btrfs receive --quiet ${DEPLOY_PATH} <${IMG_FILE}
		elif [[ "${IMG_FILE##*.}" == "zst" ]]; then
			zstd -d -c ${IMG_FILE} | btrfs receive --quiet ${DEPLOY_PATH}
		elif [[ "${IMG_FILE##*.}" == "xz" || "${IMG_FILE##*.}" == "skosys" ]]; then
			if [[ "${IMG_FILE}" == *".tar.xz" ]]; then
				tar xfO ${IMG_FILE} | btrfs receive --quiet ${DEPLOY_PATH}
			else
				xz -dc ${IMG_FILE} | btrfs receive --quiet ${DEPLOY_PATH}
			fi
		else
			echo "Unsupported file format: ${IMG_FILE}" >&2
			exit 1
		fi
	fi

	# Create baseline before any migration scripts modify the subvolume,
	# so it stays consistent with the pure btrfs-receive result used by CI delta generation.
	create_baseline "${MOUNT_PATH}" "${SUBVOL}" "${NAME}" 2>/dev/null || true

	mkdir -p ${MOUNT_PATH}/boot/${NAME}
	cp ${SUBVOL}/boot/vmlinuz-linux ${MOUNT_PATH}/boot/${NAME}
	cp ${SUBVOL}/boot/initramfs-linux.img ${MOUNT_PATH}/boot/${NAME}
	sync

	echo "show boot files"
	ls -R ${SUBVOL}/boot/

	# now that the initramfs has been built determine if that includes microcode
	AMD_UCODE="# missing intel-ucode"
	INTEL_UCODE="# missing intel-ucode"

	if grep -q "microcode" "/etc/mkinitcpio.conf"; then
		echo "microcode hook present: will skip systemd-boot initrd."

		AMD_UCODE="# amd-ucode in initramfs"
		INTEL_UCODE="# intel-ucode in initramfs"
	else
		echo "microcode hook not found: will use systemd-bood initrd."
		if [ -e ${SUBVOL}/boot/amd-ucode.img ]; then
			cp ${SUBVOL}/boot/amd-ucode.img ${MOUNT_PATH}/boot/${NAME}
			AMD_UCODE="initrd /${NAME}/amd-ucode.img"
		fi

		if [ -e ${SUBVOL}/boot/intel-ucode.img ]; then
			cp ${SUBVOL}/boot/intel-ucode.img ${MOUNT_PATH}/boot/${NAME}
			INTEL_UCODE="initrd /${NAME}/intel-ucode.img"
		fi
		sync
	fi

	ADDITIONAL_ARGUMENTS=""
	if [ -e ${SUBVOL}/usr/lib/frzr.d/bootconfig.conf ]; then
		# ADDITIONAL_ARGUMENTS="$ADDITIONAL_ARGUMENTS $(cat ${SUBVOL}/usr/lib/frzr.d/bootconfig.conf)"
		if [ -n "${ADDITIONAL_ARGUMENTS}" ]; then
			ADDITIONAL_ARGUMENTS="${ADDITIONAL_ARGUMENTS} $(cat ${SUBVOL}/usr/lib/frzr.d/bootconfig.conf)"
		else
			ADDITIONAL_ARGUMENTS="$(cat ${SUBVOL}/usr/lib/frzr.d/bootconfig.conf)"
		fi
	fi

	# create_swap "${MOUNT_PATH}" "${SUBVOL}"
	SWAP_ARGUMENTS=""
	if [ -f ${MOUNT_PATH}/swap/swapfile ]; then
		resume="resume=PARTUUID=$(lsblk -no PARTUUID "$(mount | grep " ${MOUNT_PATH} " | cut -d' ' -f1)")"
		resume_offset="resume_offset=$(btrfs inspect-internal map-swapfile -r ${MOUNT_PATH}/swap/swapfile)"
		SWAP_ARGUMENTS="${resume} ${resume_offset}"
	fi

	# create_nix "${MOUNT_PATH}"

	FBCON="$(get_fbcon)"

	# get_boot_cfg "${NAME}" "${AMD_UCODE}" "${INTEL_UCODE}" "${ADDITIONAL_ARGUMENTS}" "${SWAP_ARGUMENTS} ${FBCON}" > ${BOOT_CFG}
	BOOT_CFG_PARA=$(get_boot_cfg "${NAME}" "${AMD_UCODE}" "${INTEL_UCODE}" "${ADDITIONAL_ARGUMENTS}" "${SWAP_ARGUMENTS}" "${FBCON}")
	echo "${BOOT_CFG_PARA}" >${BOOT_CFG}
	export BOOT_CFG_PARA="${BOOT_CFG_PARA}"
	echo "default frzr.conf" >${MOUNT_PATH}/boot/loader/loader.conf
	sync

	# Backup boot config to btrfs for recovery by frzr-esp-guard initramfs hook
	BOOT_BACKUP_DIR="${MOUNT_PATH}/boot_backup"
	mkdir -p "${BOOT_BACKUP_DIR}"
	cp "${BOOT_CFG}" "${BOOT_BACKUP_DIR}/frzr.conf.bak"
	cp "${MOUNT_PATH}/boot/loader/loader.conf" "${BOOT_BACKUP_DIR}/loader.conf.bak"

	# Check if there are migrations available
	if compgen -G "${SUBVOL}"/usr/lib/frzr.d/*.migration >/dev/null; then
		for m in "${SUBVOL}"/usr/lib/frzr.d/*.migration; do
			unset -f post_install
			. $m
			if [ "$(type -t post_install)" == function ]; then
				post_install "${MOUNT_PATH}" "${SUBVOL}" "${NAME}" || true
			fi
			unset -f post_install
		done
	fi

	# Export variables to be used by child processes for frzr-tweaks and frzr-initramfs
	export MOUNT_PATH
	export SUBVOL
	export NAME

	# Check if the FIRMWARE_OVERRIDE variable is set by the install media, if so enable firmware overrides
	if [ -n "${FIRMWARE_OVERRIDE}" ]; then
		echo "export USE_FIRMWARE_OVERRIDES=1" >${MOUNT_PATH}/etc/device-quirks.conf
	fi

	# Run frzr-tweaks to execute the device-quirks to be supplied by the deployed images
	frzr-tweaks

	# Run frzr-initramfs to create mkinicpio.conf and build an initramfs
	frzr-initramfs

	# Re-sync rebuilt initramfs to ESP (frzr-initramfs rebuilds inside the subvol)
	if [ -f "${SUBVOL}/boot/initramfs-linux.img" ]; then
		if ! cmp -s "${SUBVOL}/boot/initramfs-linux.img" "${MOUNT_PATH}/boot/${NAME}/initramfs-linux.img" 2>/dev/null; then
			cp "${SUBVOL}/boot/initramfs-linux.img" "${MOUNT_PATH}/boot/${NAME}/initramfs-linux.img"
			sync
		fi
	fi

	# check and clean etc
	CURRENT_BRANCH=$(get_branch "${CURRENT}")
	NEW_BRANCH=$(get_branch "${NAME}")
	if [ "$CURRENT_BRANCH" != "$NEW_BRANCH" ]; then
		echo "clean-etc: ${CURRENT_BRANCH} -> ${NEW_BRANCH}"
		if [ -f /usr/share/sk-chos-tool/scripts/etc_repair.sh ]; then
			/usr/share/sk-chos-tool/scripts/etc_repair.sh
		else
			echo "etc_repair.sh not found"
		fi
	fi

	rm -f ${MOUNT_PATH}/*.img.*
	rm -f ${MOUNT_PATH}/*.skosys
	rm -f ${MOUNT_PATH}/*.skdelta

	rm -rf /var/lib/pacman # undo frzr-unlock

	echo "deployment complete; restart to boot into ${NAME}"
}

if [ "$0" = "$BASH_SOURCE" ]; then
	main "$@"
fi
