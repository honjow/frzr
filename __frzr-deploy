	for mirror in "${api_mirrors[@]}"; do
		echo "尝试API镜像站: ${mirror}" >&2
		echo "正在从镜像站获取发布信息: ${mirror}" >&2

		local releases=$(curl --http1.1 -L -s --connect-timeout 60 -m 60 "${mirror}")
